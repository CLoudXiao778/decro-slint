import { ScrollView, ListView, Palette } from "std-widgets.slint";

export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    meta: string,
    duration: string,
    quality: string,
    cover: image,
    tint: color,
}

export struct PlaylistItem {
    id: string,
    title: string,
    meta: string,
    cover: image,
    tint: color,
    pinned: bool,
}

export struct ArtistLinkItem {
    id: string,
    name: string,
}

export struct LyricItem {
    time: float,
    text: string,
    translation: string,
}

export struct LyricResultItem {
    track: TrackItem,
    lines: string,
}

// ── Theme tokens ─────────────────────────────────────────────────────────
// The immersive player and the queue panel intentionally stay dark in both
// themes. Everything else reads these semantic tokens.
export global Theme {
    in-out property <bool> dark: true;

    out property <color> bg: dark ? #000000 : #eff0f3;
    out property <color> shell: dark ? #09090b : #f7f7f9;
    out property <color> sidebar: dark ? #08080a : #ececef;
    out property <color> surface: dark ? #1b1c1e : #ffffff;
    out property <color> surface-2: dark ? #17171a : #f6f6f8;
    out property <color> surface-3: dark ? #242528 : #eeeef1;
    out property <color> hover: dark ? #232326 : #f1f1f4;
    out property <color> text: dark ? #f5f5f7 : #1c1c1e;
    out property <color> text-soft: dark ? #c7c7cc : #3a3a3c;
    out property <color> muted: dark ? #8e8e93 : #707077;
    out property <color> faint: dark ? #77777d : #98989f;
    out property <color> border: dark ? #ffffff12 : #00000014;
    out property <color> border-soft: dark ? #ffffff10 : #0000000d;
    out property <color> border-strong: dark ? #ffffff1a : #0000001f;
    out property <color> overlay: dark ? #ffffff0d : #00000008;
    out property <color> overlay-hover: dark ? #ffffff1a : #0000000f;
    out property <color> accent: #ff645d;
    out property <color> accent-soft: dark ? #c9202726 : #c9202714;
    out property <color> on-accent: #ffffff;
    out property <color> danger: #d13438;
    out property <color> inverse: dark ? #ffffff : #111111;

    // Fixed palette for the always-dark player surfaces.
    out property <color> player-text: #ffffff;
    out property <color> player-muted: #ffffffa8;
    out property <color> player-faint: #ffffff5c;
}

// ── Small building blocks ────────────────────────────────────────────────

component Glyph inherits Image {
    in property <length> glyph-size: 18px;
    in-out property <color> tint: Theme.muted;
    animate tint { duration: 160ms; }
    width: root.glyph-size;
    height: root.glyph-size;
    colorize: root.tint;
    image-fit: contain;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 17px;
    in property <color> tint: Theme.muted;
    in property <color> hover-tint: Theme.text;
    in property <color> hover-background: Theme.overlay;
    in property <color> idle-background: transparent;
    in property <bool> danger;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: tap.has-hover ? (root.danger ? #d13438 : root.hover-background) : root.idle-background;
    animate background { duration: 120ms; }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: root.icon-size;
        tint: tap.has-hover ? (root.danger ? #ffffff : root.hover-tint) : root.tint;
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component NavIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.active ? Theme.accent-soft : (tap.has-hover ? Theme.overlay : transparent);
    animate background { duration: 140ms; }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: 20px;
        tint: root.active ? Theme.accent : (tap.has-hover ? Theme.text : Theme.muted);
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> disabled;
    in property <bool> on-dark;
    callback clicked();
    height: 32px;
    width: 96px;
    border-radius: 16px;
    background: root.primary ? (tap.has-hover ? #ff7d76 : #ff645d) : (root.on-dark ? (tap.has-hover ? #ffffff2e : #ffffff14) : (tap.has-hover ? Theme.overlay-hover : Theme.overlay));
    border-width: root.primary ? 0px : 1px;
    border-color: root.on-dark ? #ffffff2e : Theme.border-strong;
    opacity: root.disabled ? 0.4 : 1;
    animate background { duration: 140ms; }
    label-text := Text {
        text: root.label;
        color: root.primary ? Theme.on-accent : (root.on-dark ? #ffffff : Theme.text-soft);
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }
    tap := TouchArea {
        clicked => {
            if !root.disabled {
                root.clicked();
            }
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? #ff645d : (Theme.dark ? #48484f : #c7c7cc);
    animate background { duration: 150ms; }
    Rectangle {
        x: root.checked ? root.width - 23px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea { clicked => { root.toggled(!root.checked); } }
}

component SettingsToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled(bool);
    height: 74px;
    border-radius: 16px;
    background: Theme.surface-3;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.description; color: Theme.muted; font-size: 11px; overflow: elide; }
        }
        Switch {
            checked: root.checked;
            toggled(value) => { root.toggled(value); }
        }
    }
}

component FlyingControl inherits Rectangle {
    in property <length> tx;
    in property <length> ty;
    in property <length> tw: 40px;
    in property <length> th: 40px;
    in property <image> icon;
    in-out property <length> icon-size: 22px;
    in-out property <color> tint: #ffffff;
    in property <color> fill: transparent;
    in property <length> corner: 20px;
    x: root.tx;
    y: root.ty;
    width: root.tw;
    height: root.th;
    background: root.fill;
    border-radius: root.corner;
    clip: true;
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: root.icon-size;
        tint: root.tint;
    }
    animate x, y, width, height, border-radius, icon-size { duration: 380ms; easing: ease-out; }
    animate background { duration: 380ms; easing: ease-out; }
}

component RoundIconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <length> button-size: 62px;
    in property <color> background-color: #ffffff21;
    in property <color> tint: #ffffff;
    in property <bool> enabled: true;
    callback clicked();
    width: root.button-size;
    height: root.button-size;
    border-radius: self.width / 2;
    background: tap.has-hover ? #ffffff30 : root.background-color;
    opacity: root.enabled ? 1 : 0.55;
    transform-scale-x: tap.pressed ? 92% : (tap.has-hover ? 105% : 100%);
    transform-scale-y: tap.pressed ? 92% : (tap.has-hover ? 105% : 100%);
    animate background { duration: 140ms; }
    animate transform-scale-x, transform-scale-y { duration: 120ms; easing: ease-out; }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: root.icon-size;
        tint: root.tint;
    }
    tap := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component PlayerMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> enabled: true;
    in property <bool> active;
    callback clicked();
    height: 37px;
    border-radius: 9px;
    background: root.enabled && tap.has-hover ? #ffffff12 : transparent;
    opacity: root.enabled ? 1 : 0.38;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 10px;
        cross-axis-alignment: center;
        Glyph { source: root.icon; glyph-size: 15px; tint: #ffffffb3; }
        Text { horizontal-stretch: 1; text: root.label; color: #f5f5f7; font-size: 12px; vertical-alignment: center; overflow: elide; }
        if root.active : Glyph { source: @image-url("../assets/icons/check.svg"); glyph-size: 14px; tint: #ff645d; }
    }
    tap := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component PlayerQualityChip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 27px;
    border-radius: 8px;
    background: root.active ? #ffffff26 : (qc-tap.has-hover ? #ffffff12 : #ffffff08);
    border-width: 1px;
    border-color: root.active ? #ffffff38 : transparent;
    Text {
        text: root.label;
        color: root.active ? #ffffff : #ffffffa8;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    qc-tap := TouchArea { clicked => { root.clicked(); } }
}

component InlineLink inherits Rectangle {
    in property <string> label;
    in property <length> font-size: 14px;
    in property <color> idle-color: #ffffff85;
    in property <bool> interactive: true;
    callback clicked();
    width: link-text.width;
    height: root.font-size + 6px;
    horizontal-stretch: 0;
    background: transparent;
    link-text := Text {
        text: root.label;
        color: tap.has-hover && root.interactive ? #ffffff : root.idle-color;
        font-size: root.font-size;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        visible: tap.has-hover && root.interactive;
        x: 0;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: #ffffff;
    }
    tap := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── Content components ───────────────────────────────────────────────────

component FeatureCard inherits Rectangle {
    in property <PlaylistItem> item;
    in property <string> eyebrow;
    callback clicked();
    border-radius: 26px;
    clip: true;
    background: root.item.tint;
    Image {
        width: 100%;
        height: 100%;
        source: root.item.cover;
        image-fit: cover;
        transform-scale-x: tap.has-hover ? 103% : 100%;
        transform-scale-y: tap.has-hover ? 103% : 100%;
        animate transform-scale-x, transform-scale-y { duration: 420ms; easing: ease-out; }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        // Keep overlays to two colour stops. The software renderer splits a
        // multi-stop gradient into segments and can double-blend the shared
        // scanline, which shows up as a dark horizontal line.
        background: @linear-gradient(180deg, #00000000 20%, #000000d9 100%);
    }
    VerticalLayout {
        alignment: end;
        padding: 28px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            cross-axis-alignment: center;
            Glyph {
                source: @image-url("../assets/icons/sparkles.svg");
                glyph-size: 13px;
                tint: #ffffffb3;
            }
            Text {
                text: root.eyebrow;
                color: #ffffffb3;
                font-size: 10px;
                font-weight: 650;
                letter-spacing: 1px;
            }
        }
        Text {
            text: root.item.title;
            color: #ffffff;
            font-size: 34px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.item.meta;
            color: #ffffffab;
            font-size: 12px;
            overflow: elide;
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component ShelfCard inherits Rectangle {
    in property <PlaylistItem> item;
    callback clicked();
    width: 176px;
    height: 222px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: 176px;
            height: 176px;
            border-radius: 18px;
            background: root.item.tint;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
                transform-scale-x: tap.has-hover ? 104% : 100%;
                transform-scale-y: tap.has-hover ? 104% : 100%;
                animate transform-scale-x, transform-scale-y { duration: 360ms; easing: ease-out; }
            }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♫";
                color: #ffffff77;
                font-size: 42px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.meta;
            color: Theme.muted;
            font-size: 10px;
            overflow: elide;
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component TrackShelfCard inherits Rectangle {
    in property <TrackItem> item;
    callback clicked();
    width: 176px;
    height: 222px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: 176px;
            height: 176px;
            border-radius: 18px;
            background: root.item.tint;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
                transform-scale-x: tap.has-hover ? 104% : 100%;
                transform-scale-y: tap.has-hover ? 104% : 100%;
                animate transform-scale-x, transform-scale-y { duration: 360ms; easing: ease-out; }
            }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff77;
                font-size: 42px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.title;
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.artist;
            color: Theme.muted;
            font-size: 10px;
            overflow: elide;
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component MediaRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> current;
    callback clicked();
    height: 72px;
    border-radius: 16px;
    clip: true;
    background: root.current ? Theme.accent-soft : (tap.has-hover ? Theme.hover : Theme.surface-2);
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: root.item.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.cover; image-fit: cover; }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff77;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text { text: root.item.title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.item.artist + " · " + root.item.meta; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.current : Rectangle {
            width: 7px; height: 7px; border-radius: 4px; background: #ff645d;
        }
        Text { text: root.item.duration; color: Theme.faint; font-size: 11px; vertical-alignment: center; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component LyricResultRow inherits Rectangle {
    in property <LyricResultItem> item;
    callback clicked();
    height: 88px;
    border-radius: 16px;
    clip: true;
    background: tap.has-hover ? Theme.hover : Theme.surface-2;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        cross-axis-alignment: center;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: root.item.track.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.track.cover; image-fit: cover; }
            if root.item.track.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪"; color: #ffffff77; font-size: 20px;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.item.track.title; color: Theme.text; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.item.track.artist; color: Theme.muted; font-size: 11px; overflow: elide; }
            Text { text: root.item.lines; color: Theme.text-soft; font-size: 12px; overflow: elide; }
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component PlaylistRow inherits Rectangle {
    in property <PlaylistItem> item;
    in property <bool> circle;
    in property <bool> show-pin;
    callback clicked();
    callback pin-toggled();
    height: 72px;
    border-radius: 16px;
    clip: true;
    background: tap.has-hover ? Theme.hover : Theme.surface-2;
    animate background { duration: 150ms; }
    tap := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: root.circle ? 26px : 12px;
            background: root.item.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.cover; image-fit: cover; }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: root.circle ? "♬" : "♫";
                color: #ffffff77;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text { text: root.item.title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.item.meta; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.show-pin : Rectangle {
            width: 30px;
            height: 30px;
            border-radius: 9px;
            background: pin-tap.has-hover ? Theme.overlay-hover : transparent;
            Glyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/icons/pin.svg");
                glyph-size: 15px;
                tint: root.item.pinned ? Theme.accent : Theme.faint;
            }
            pin-tap := TouchArea { clicked => { root.pin-toggled(); } }
        }
        Glyph { source: @image-url("../assets/icons/chevron-right.svg"); glyph-size: 15px; tint: Theme.faint; }
    }
}

component DetailRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> current;
    callback clicked();
    callback more-clicked(length, length);
    height: 76px;
    border-radius: 16px;
    clip: true;
    background: root.current ? Theme.accent-soft : (tap.has-hover ? Theme.overlay-hover : Theme.overlay);
    border-width: 1px;
    border-color: root.current ? #c9202755 : transparent;
    animate background { duration: 150ms; }
    tap := TouchArea { clicked => { root.clicked(); } }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        Rectangle {
            width: 54px;
            height: 54px;
            border-radius: 13px;
            background: root.item.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.cover; image-fit: cover; }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff77;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text { text: root.item.title; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.item.artist; color: Theme.muted; font-size: 12px; overflow: elide; }
        }
        if root.current : Rectangle {
            width: 8px; height: 8px; border-radius: 4px; background: #ff645d;
        }
        Text { text: root.item.duration; color: Theme.muted; font-size: 11px; vertical-alignment: center; }
        Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            background: row-more-tap.has-hover ? Theme.overlay-hover : transparent;
            Glyph {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                source: @image-url("../assets/icons/more.svg");
                glyph-size: 15px;
                tint: Theme.muted;
            }
            row-more-tap := TouchArea {
                clicked => {
                    root.more-clicked(self.absolute-position.x, self.absolute-position.y);
                }
            }
        }
    }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "搜索歌曲、歌手、歌单";
    in property <int> focus-tick: 0;
    callback accepted();
    public function focus-input() { input.focus(); }
    init => { input.focus(); }
    changed focus-tick => { input.focus(); }
    height: 64px;
    border-radius: 32px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;
        Glyph { source: @image-url("../assets/icons/search.svg"); glyph-size: 20px; tint: Theme.muted; }
        Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            background: transparent;
            TouchArea { clicked => { input.focus(); } }
            if root.text.is-empty : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: root.placeholder;
                color: Theme.faint;
                font-size: 16px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 0; y: 0; width: 100%; height: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: 16px;
                vertical-alignment: center;
                accepted => { root.accepted(); }
            }
        }
        if !root.text.is-empty : IconButton {
            icon: @image-url("../assets/icons/close.svg");
            icon-size: 14px;
            width: 28px;
            height: 28px;
            clicked => { root.text = ""; }
        }
        PillButton {
            label: "搜索";
            width: 68px;
            primary: true;
            disabled: root.text.is-empty;
            clicked => { root.accepted(); }
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> autofocus;
    callback accepted();
    init => { if root.autofocus { input.focus(); } }
    height: 40px;
    border-radius: 10px;
    background: Theme.surface-2;
    border-width: 1px;
    border-color: Theme.border;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            TouchArea { clicked => { input.focus(); } }
            if root.text.is-empty : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: root.placeholder;
                color: Theme.faint;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 0; y: 0; width: 100%; height: 100%;
                text <=> root.text;
                color: Theme.text;
                font-size: 12px;
                vertical-alignment: center;
                accepted => { root.accepted(); }
            }
        }
    }
}

component SeekBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum;
    in property <bool> playing;
    in property <bool> low-power;
    callback seek(float);
    height: 26px;
    property <length> fill-width: root.maximum > 0
        ? min(root.width, root.width * max(0, min(1, root.value / root.maximum)))
        : 0px;
    // Unplayed hairline.
    Rectangle {
        x: root.fill-width;
        y: (parent.height - 3px) / 2;
        width: max(0px, root.width - root.fill-width);
        height: 3px;
        border-radius: 2px;
        background: #ffffff75;
    }
    // Played area: animated sine wave while playing, flat line when paused or
    // in performance mode.
    Rectangle {
        x: 0;
        y: (parent.height - 16px) / 2;
        width: root.fill-width;
        height: 16px;
        clip: true;
        if root.playing && !root.low-power : Image {
            x: -(mod(animation-tick(), 1250ms) / 1250ms) * 32px;
            y: 0;
            width: 3840px;
            height: 16px;
            source: @image-url("../assets/wave.svg");
            image-fit: fill;
            opacity: 0.86;
        }
        if !root.playing || root.low-power : Rectangle {
            y: (parent.height - 3px) / 2;
            width: 100%;
            height: 3px;
            border-radius: 2px;
            background: #ffffffdb;
        }
    }
    Rectangle {
        x: root.fill-width - 2px;
        y: (parent.height - 34px) / 2;
        width: 4px;
        height: 34px;
        border-radius: 2px;
        background: #ffffff;
        visible: root.maximum > 0;
    }
    tap := TouchArea {
        clicked => {
            root.seek(root.maximum * max(0, min(1, tap.mouse-x / self.width)));
        }
        moved => {
            if (tap.pressed) {
                root.seek(root.maximum * max(0, min(1, tap.mouse-x / self.width)));
            }
        }
    }
}

component VolumeBar inherits Rectangle {
    in-out property <float> value;
    callback changed(float);
    callback released();
    height: 22px;
    width: 110px;
    property <length> fill-width: root.width * max(0, min(1, root.value));
    Rectangle {
        x: 0;
        y: (parent.height - 2px) / 2;
        width: 100%;
        height: 2px;
        border-radius: 1px;
        background: #ffffff38;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 2px) / 2;
        width: root.fill-width;
        height: 2px;
        border-radius: 1px;
        background: #ffffffb8;
    }
    tap := TouchArea {
        clicked => {
            root.value = max(0, min(1, tap.mouse-x / self.width));
            root.changed(root.value);
        }
        moved => {
            if (tap.pressed) {
                root.value = max(0, min(1, tap.mouse-x / self.width));
                root.changed(root.value);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.released();
            }
        }
    }
}

// ── Lyric view ───────────────────────────────────────────────────────────

component LyricView inherits Flickable {
    in property <[LyricItem]> lines;
    in property <int> current;
    in property <length> line-height: 64px;
    in property <length> verse-padding;
    in property <bool> show-translation;
    in-out property <length> scroll-target;
    callback line-clicked(int, float);
    callback height-changed(length);
    callback user-scrolled(length);

    content-width: self.width;
    content-height: 2 * root.verse-padding + root.lines.length * root.line-height;
    // `scroll-target` is a positive scrollTop; Flickable content-y is the
    // negative position of the content.
    content-y: -root.scroll-target;
    changed scroll-target => { self.content-y = -root.scroll-target; }
    changed height => { root.height-changed(self.height); }
    init => { root.height-changed(self.height); }
    flicked => { root.user-scrolled(-self.content-y); }

    for line[index] in root.lines : Rectangle {
        y: root.verse-padding + index * root.line-height;
        width: parent.width;
        height: root.line-height;
        background: line-tap.has-hover ? #ffffff08 : transparent;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                horizontal-stretch: 1;
                text: line.text;
                color: index == root.current ? #ffffff : #ffffff78;
                font-size: index == root.current ? 38px : 23px;
                font-weight: index == root.current ? 700 : 400;
                horizontal-alignment: center;
                overflow: elide;
                animate color { duration: 180ms; }
            }
            if line.translation != "" && root.show-translation : Text {
                horizontal-stretch: 1;
                text: line.translation;
                color: index == root.current ? #ffffffa8 : #ffffff66;
                font-size: index == root.current ? 15px : 12px;
                horizontal-alignment: center;
                overflow: elide;
                animate color { duration: 180ms; }
            }
        }
        line-tap := TouchArea {
            clicked => { root.line-clicked(index, line.time); }
        }
    }
}

// ── Window ───────────────────────────────────────────────────────────────

export component AppWindow inherits Window {
    no-frame: true;
    resize-border-width: 6px;
    title: "Decro";
    icon: @image-url("../assets/icon.png");
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 640px;
    background: Theme.bg;
    default-font-family: "Segoe UI";
    in-out property <bool> dark-mode: true;
    init => {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed dark-mode => {
        Theme.dark = root.dark-mode;
        Palette.color-scheme = root.dark-mode ? ColorScheme.dark : ColorScheme.light;
    }
    changed page => {
        root.player-menu-open = false;
        root.detail-more-open = false;
        root.detail-track-menu-id = "";
    }

    private property <length> titlebar-height: 48px;
    private property <length> dock-height: 82px;
    private property <length> sidebar-width: 76px;
    private property <length> lyric-line-height: 64px;
    private property <length> lyric-view-height: 430px;
    private property <length> lyric-padding: max(0px, (root.lyric-view-height - root.lyric-line-height) / 2);

    // Account / session
    in property <bool> logged-in;
    in property <string> account-name: "";
    in property <string> account-id: "";
    in property <string> account-initial: "D";
    in-out property <bool> login-open;
    in property <image> qr-image;
    in-out property <string> cookie-text: "";

    // Pages
    in property <string> page: "home";
    in property <string> status-text: "";
    in property <string> data-dir: "";
    in property <string> quality: "exhigh";
    in property <string> log-level: "info";
    in property <bool> low-power;
    in property <bool> show-translation: true;
    in property <bool> cover-accent: true;

    // Models
    in property <[PlaylistItem]> playlists;
    in property <PlaylistItem> daily-feature;
    in property <PlaylistItem> feature-playlist;
    in property <[TrackItem]> recent-tracks;
    in property <[TrackItem]> daily-tracks;
    in property <[TrackItem]> new-tracks;
    in property <[PlaylistItem]> library-playlists;
    in property <int> library-common-count: 8;
    in property <int> library-playlists-total: 0;
    in-out property <bool> library-playlists-expanded;
    in property <[TrackItem]> library-tracks;
    in property <[TrackItem]> detail-tracks;
    in property <string> detail-title: "";
    in property <string> detail-meta: "";
    in property <string> detail-description: "";
    in property <string> detail-first-id: "";
    in property <color> detail-cover-tint: Theme.surface-2;
    in property <image> detail-backdrop;
    in property <[PlaylistItem]> detail-albums;
    in property <bool> detail-subscribed;
    in property <string> detail-kind: "";
    in property <string> detail-id: "";
    in property <string> detail-origin: "home";
    in-out property <bool> detail-more-open;
    in-out property <string> detail-track-menu-id: "";
    in-out property <string> detail-track-menu-text: "";
    in-out property <length> detail-track-menu-x;
    in-out property <length> detail-track-menu-y;
    in property <[TrackItem]> search-tracks;
    in property <[PlaylistItem]> search-playlists;
    in property <[PlaylistItem]> search-artists;
    in property <[PlaylistItem]> search-albums;
    in property <[LyricResultItem]> search-lyrics;
    in-out property <string> search-kind: "song";
    in-out property <string> search-text: "";
    in property <string> search-query: "";
    in property <bool> search-loading;
    in-out property <int> search-focus-tick;
    private property <bool> search-active: !root.search-text.is-empty
        && root.search-query == root.search-text
        && !root.search-loading;
    in-out property <bool> playlist-dialog-open;
    in-out property <string> playlist-dialog-mode: "create";
    in-out property <string> playlist-dialog-text: "";

    // Player
    in property <string> current-id: "";
    in property <string> current-title: "";
    in property <string> current-artist: "";
    in property <string> current-album: "";
    in property <string> current-artist-id: "";
    in property <string> current-album-id: "";
    in property <[ArtistLinkItem]> current-artists;
    in property <string> current-quality: "";
    in property <string> current-track-quality: "";
    in-out property <bool> player-menu-open;
    in property <color> current-cover: #c92027;
    in property <image> current-cover-image;
    in property <image> current-backdrop;
    in property <string> position-text: "00:00";
    in property <string> duration-text: "00:00";
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> current-liked;
    in-out property <float> progress;
    in property <float> duration;
    in-out property <float> volume: 0.64;
    in-out property <bool> player-open;
    in-out property <bool> player-visible;
    in-out property <bool> cover-flying;
    in-out property <bool> controls-ready: true;
    in-out property <bool> window-minimized;
    in property <[TrackItem]> queue-tracks;
    in property <int> queue-index;
    in-out property <bool> queue-open;
    in-out property <bool> repaint-nudge;
    private property <length> player-cover-size: 360px;
    in-out property <length> player-cover-target-x: 68px + ((root.width - 136px) * 0.4 - 360px) / 2;
    in-out property <length> player-cover-target-y: root.titlebar-height + 60px + (root.height - root.titlebar-height - 196px - 360px) / 2;
    in-out property <length> player-cover-target-w: 360px;
    in-out property <length> player-cover-target-h: 360px;
    in-out property <length> player-play-target-x: (root.width - 96px) / 2;
    in-out property <length> player-play-target-y: root.height - 118px;
    in-out property <length> player-play-target-w: 96px;
    in-out property <length> player-play-target-h: 64px;
    in-out property <length> player-next-target-x: (root.width + 96px) / 2 + 22px;
    in-out property <length> player-next-target-y: root.height - 122px;
    in-out property <length> player-next-target-w: 62px;
    in-out property <length> player-next-target-h: 62px;
    in-out property <bool> lyrics-mode;
    in property <[LyricItem]> lyrics;
    in property <int> lyric-index;
    in-out property <bool> lyric-follow: true;
    in-out property <length> lyric-scroll-y;
    out property <length> lyric-target-y: root.lyric-y-for(root.lyric-index);

    pure function lyric-y-for(index: int) -> length {
        // `lyric-scroll-y` is a positive scroll offset. The Flickable's
        // `content-y` is the negative position of the content, so callers bind
        // it to `-lyric-scroll-y`. The padding accounts for the first and last
        // line so those can also be centered.
        return max(0px, min(
            index * root.lyric-line-height,
            max(0px, (root.lyrics.length - 1) * root.lyric-line-height)
        ));
    }

    callback refresh-qr();
    callback import-cookie(string);
    callback close-login();
    callback logout();
    callback nav(string);
    callback search(string, string);
    callback open-playlist(string);
    callback toggle-playlist-pin(string);
    callback toggle-library-playlists();
    callback play-detail-shuffle();
    callback copy-detail-link();
    callback open-detail-link();
    callback copy-song-info(string);
    callback toggle-track-like(string);
    callback set-track-quality(string);
    callback open-daily();
    callback open-artist(string);
    callback open-album(string);
    callback back-detail();
    callback toggle-subscribe();
    callback open-playlist-dialog(string);
    callback close-playlist-dialog();
    callback submit-playlist-dialog(string);
    callback play-track(string, string);
    callback play-detail(string);
    callback toggle-play();
    callback toggle-like();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    callback volume-released(float);
    callback seek-lyric(float);
    callback set-quality(string);
    callback set-theme(string);
    callback set-log-level(string);
    callback set-low-power(bool);
    callback set-cover-accent(bool);
    callback set-show-translation(bool);
    callback open-log-folder();
    callback open-player();
    callback close-player();
    callback toggle-queue();
    callback play-queue(int);
    callback quit-app();

    // Page transition is expressed with a soft opacity fade.
    in-out property <float> page-opacity: 1;
    in property <image> ambient-background;
    in-out property <bool> workspace-hidden;

    // Ambient wash, pre-rendered in Rust so scrolling does not evaluate
    // two large radial gradients every frame.
    Image {
        visible: !root.workspace-hidden && root.dark-mode;
        x: 0; y: 0;
        width: 100%; height: 100%;
        source: root.ambient-background;
        image-fit: fill;
    }

    VerticalLayout {
        spacing: 0px;

        // ── Custom titlebar ─────────────────────────────────────────────
        Rectangle {
            height: root.titlebar-height;
            background: Theme.shell;
            border-width: 1px;
            border-color: Theme.border-soft;
            z: 20;
            WindowMoveArea { }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 10px;
                spacing: 10px;
                cross-axis-alignment: center;

                HorizontalLayout {
                    width: 150px;
                    spacing: 9px;
                    cross-axis-alignment: center;
                    Image {
                        width: 27px;
                        height: 27px;
                        source: @image-url("../assets/icon.png");
                        image-fit: contain;
                    }
                    Text { text: "Decro"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "DESKTOP"; color: Theme.muted; font-size: 8px; font-weight: 650; letter-spacing: 1.4px; vertical-alignment: center; }
                }

                IconButton {
                    icon: @image-url("../assets/icons/chevron-left.svg");
                    icon-size: 16px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.nav("home"); }
                }
                IconButton {
                    icon: root.dark-mode ? @image-url("../assets/icons/moon.svg") : @image-url("../assets/icons/sun.svg");
                    icon-size: 15px;
                    width: 28px;
                    height: 28px;
                    clicked => {
                        root.dark-mode = !root.dark-mode;
                        root.set-theme(root.dark-mode ? "dark" : "light");
                    }
                }

                Rectangle {
                    width: 310px;
                    height: 30px;
                    border-radius: 9px;
                    background: search-trigger-tap.has-hover ? Theme.overlay-hover : Theme.overlay;
                    border-width: 1px;
                    border-color: Theme.border;
                    animate background { duration: 140ms; }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Glyph { source: @image-url("../assets/icons/search.svg"); glyph-size: 15px; tint: Theme.muted; }
                        Text { horizontal-stretch: 1; text: "搜索歌曲、歌单、歌手、专辑"; color: Theme.muted; font-size: 11px; vertical-alignment: center; overflow: elide; }
                    }
                    search-trigger-tap := TouchArea {
                        clicked => {
                            root.nav("search");
                            root.search-focus-tick += 1;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    height: 30px;
                    width: 110px;
                    border-radius: 15px;
                    background: account-tap.has-hover ? Theme.overlay : transparent;
                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 7px;
                        spacing: 7px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, #7e838d, #3c4149);
                            Text { text: root.account-initial; color: #ffffff; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { horizontal-stretch: 1; text: root.logged-in ? root.account-name : "登录"; color: Theme.text-soft; font-size: 11px; vertical-alignment: center; overflow: elide; }
                    }
                    account-tap := TouchArea {
                        clicked => {
                            if root.logged-in {
                                root.nav("settings");
                            } else {
                                root.login-open = true;
                                root.refresh-qr();
                            }
                        }
                    }
                }

                IconButton {
                    icon: @image-url("../assets/icons/grid.svg");
                    icon-size: 17px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.nav("explore"); }
                }
                IconButton {
                    icon: @image-url("../assets/icons/settings.svg");
                    icon-size: 17px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.nav("settings"); }
                }

                Rectangle {
                    height: 26px;
                    width: 1px;
                    background: Theme.border-strong;
                }

                IconButton {
                    icon: @image-url("../assets/icons/minimize.svg");
                    icon-size: 13px;
                    width: 34px;
                    height: 30px;
                    clicked => { root.minimized = true; }
                }
                IconButton {
                    icon: @image-url("../assets/icons/maximize.svg");
                    icon-size: 12px;
                    width: 34px;
                    height: 30px;
                    clicked => { root.maximized = !root.maximized; }
                }
                IconButton {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 13px;
                    width: 34px;
                    height: 30px;
                    danger: true;
                    clicked => { root.quit-app(); }
                }
            }
        }

        // ── Workspace ───────────────────────────────────────────────────
        HorizontalLayout {
            visible: !root.workspace-hidden;
            vertical-stretch: 1;
            spacing: 0px;

            Rectangle {
                width: root.sidebar-width;
                background: Theme.sidebar;
                border-width: 1px;
                border-color: Theme.border-soft;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 3px;
                    cross-axis-alignment: center;
                    NavIcon {
                        icon: @image-url("../assets/icons/home.svg");
                        active: root.page == "home" || root.page == "detail";
                        clicked => { root.nav("home"); }
                    }
                    NavIcon {
                        icon: @image-url("../assets/icons/grid.svg");
                        active: root.page == "explore";
                        clicked => { root.nav("explore"); }
                    }
                    NavIcon {
                        icon: @image-url("../assets/icons/library.svg");
                        active: root.page == "library";
                        clicked => { root.nav("library"); }
                    }
                    NavIcon {
                        icon: @image-url("../assets/icons/search.svg");
                        active: root.page == "search";
                        clicked => { root.nav("search"); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: @linear-gradient(135deg, #7e838d, #3c4149);
                        Text { text: root.account-initial; color: #ffffff; font-size: 12px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                        sidebar-avatar-tap := TouchArea {
                            clicked => {
                                if root.logged-in {
                                    root.nav("settings");
                                } else {
                                    root.login-open = true;
                                    root.refresh-qr();
                                }
                            }
                        }
                    }
                }
            }

            // ── Page area ─────────────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                opacity: root.page-opacity;
                animate opacity { duration: 180ms; easing: ease-out; }

                if root.page == "home" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 24px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "主页"; color: Theme.text; font-size: 34px; font-weight: 700; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                home-avatar-tap := TouchArea { clicked => { if root.logged-in { root.nav("settings"); } else { root.login-open = true; root.refresh-qr(); } } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 20px;
                            FeatureCard {
                                horizontal-stretch: 1;
                                height: 460px;
                                item: root.daily-feature;
                                eyebrow: "今日更新";
                                clicked => { root.open-daily(); }
                            }
                            FeatureCard {
                                horizontal-stretch: 1;
                                height: 460px;
                                item: root.feature-playlist;
                                eyebrow: "为你推荐";
                                clicked => {
                                    if root.feature-playlist.id != "" {
                                        root.open-playlist(root.feature-playlist.id);
                                    }
                                }
                            }
                        }

                        if root.playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "推荐歌单"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.playlists.length * 192px;
                                content-height: self.height;
                                for item[index] in root.playlists : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.new-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "新歌速递"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.new-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.new-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id, "new"); }
                                }
                            }
                        }

                        if root.recent-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Text { text: "最近播放"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                Rectangle { horizontal-stretch: 1; }
                                PillButton { label: "查看全部"; width: 80px; clicked => { root.nav("recent"); } }
                            }
                            Flickable {
                                height: 236px;
                                content-width: root.recent-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.recent-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id, "recent"); }
                                }
                            }
                        }
                    }
                }

                if root.page == "explore" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 24px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            Text { text: "推荐"; color: Theme.text; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                explore-avatar-tap := TouchArea {
                                    clicked => {
                                        if root.logged-in {
                                            root.nav("settings");
                                        } else {
                                            root.login-open = true;
                                            root.refresh-qr();
                                        }
                                    }
                                }
                            }
                        }

                        if root.recent-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Text { text: "最近播放"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                Rectangle { horizontal-stretch: 1; }
                                PillButton { label: "查看全部"; width: 80px; clicked => { root.nav("recent"); } }
                            }
                            Flickable {
                                height: 236px;
                                content-width: root.recent-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.recent-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id, "recent"); }
                                }
                            }
                        }

                        if root.playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "推荐歌单"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.playlists.length * 192px;
                                content-height: self.height;
                                for item[index] in root.playlists : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.daily-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "每日推荐"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.daily-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.daily-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id, "daily"); }
                                }
                            }
                        }

                        if root.new-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "新歌速递"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.new-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.new-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id, "new"); }
                                }
                            }
                        }
                    }
                }

                if root.page == "library" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 20px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            Text { text: "资料库"; color: Theme.text; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.logged-in : PillButton {
                                label: "新建歌单";
                                width: 92px;
                                clicked => { root.open-playlist-dialog("create"); }
                            }
                            if root.logged-in : PillButton {
                                label: "添加歌单";
                                width: 92px;
                                clicked => { root.open-playlist-dialog("add"); }
                            }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                library-avatar-tap := TouchArea {
                                    clicked => {
                                        if root.logged-in {
                                            root.nav("settings");
                                        } else {
                                            root.login-open = true;
                                            root.refresh-qr();
                                        }
                                    }
                                }
                            }
                        }

                        if !root.logged-in : Rectangle {
                            height: 88px;
                            border-radius: 16px;
                            background: Theme.surface;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 14px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 52px; height: 52px; border-radius: 26px; background: #c92027;
                                    Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/user.svg"); glyph-size: 24px; tint: #fff; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: center;
                                    Text { text: "登录网易云音乐"; color: Theme.text; font-size: 15px; font-weight: 650; }
                                    Text { text: "扫码后自动同步你的歌单、喜欢的歌曲和最近播放。"; color: Theme.muted; font-size: 11px; overflow: elide; }
                                }
                                Glyph { source: @image-url("../assets/icons/chevron-right.svg"); glyph-size: 16px; tint: Theme.faint; }
                            }
                            library-login-tap := TouchArea { clicked => { root.login-open = true; root.refresh-qr(); } }
                        }

                        if root.logged-in && root.library-playlists.length > 0 : VerticalLayout {
                            spacing: 10px;
                            HorizontalLayout {
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text { text: "我的歌单"; color: Theme.text; font-size: 20px; font-weight: 700; }
                                Rectangle {
                                    height: 20px;
                                    width: root.library-playlists-expanded ? 34px : 38px;
                                    border-radius: 10px;
                                    background: Theme.overlay;
                                    Text {
                                        text: root.library-playlists-expanded ? "全部" : "常用";
                                        color: Theme.muted;
                                        font-size: 9px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    text: root.library-playlists-total + " 个";
                                    color: Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                                if root.library-playlists-total > root.library-common-count : PillButton {
                                    label: root.library-playlists-expanded ? "收起" : "更多";
                                    width: 72px;
                                    clicked => { root.toggle-library-playlists(); }
                                }
                            }
                            Text {
                                text: "置顶优先，其余按打开次数排序；点击图钉可置顶。";
                                color: Theme.faint;
                                font-size: 11px;
                            }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.library-playlists : PlaylistRow {
                                    item: item;
                                    show-pin: true;
                                    clicked => { root.open-playlist(item.id); }
                                    pin-toggled => { root.toggle-playlist-pin(item.id); }
                                }
                            }
                        }

                        if root.logged-in && root.library-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "最近播放"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for track in root.library-tracks : MediaRow {
                                    item: track;
                                    current: track.id == root.current-id;
                                    clicked => { root.play-track(track.id, "library-recent"); }
                                }
                            }
                        }

                        if !root.logged-in : Text {
                            text: "登录后，你的歌单和最近播放会显示在这里。";
                            color: Theme.faint;
                            font-size: 12px;
                        }
                    }
                }

                if root.page == "search" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 20px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            Text { text: "搜索"; color: Theme.text; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                search-avatar-tap := TouchArea {
                                    clicked => {
                                        if root.logged-in {
                                            root.nav("settings");
                                        } else {
                                            root.login-open = true;
                                            root.refresh-qr();
                                        }
                                    }
                                }
                            }
                        }

                        SearchField {
                            text <=> root.search-text;
                            placeholder: "搜索歌曲、歌手、歌单、专辑";
                            focus-tick: root.search-focus-tick;
                            accepted => { root.search(root.search-text, root.search-kind); }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            PillButton { label: "歌曲"; width: 84px; primary: root.search-kind == "song"; clicked => { root.search-kind = "song"; } }
                            PillButton { label: "歌单"; width: 84px; primary: root.search-kind == "playlist"; clicked => { root.search-kind = "playlist"; } }
                            PillButton { label: "歌手"; width: 84px; primary: root.search-kind == "artist"; clicked => { root.search-kind = "artist"; } }
                            PillButton { label: "专辑"; width: 84px; primary: root.search-kind == "album"; clicked => { root.search-kind = "album"; } }
                            PillButton { label: "歌词"; width: 84px; primary: root.search-kind == "lyric"; clicked => { root.search-kind = "lyric"; } }
                        }

                        if root.search-text.is-empty : Text {
                            text: "选择分类后输入关键词，搜索网易云音乐。";
                            color: Theme.faint;
                            font-size: 13px;
                        }

                        if root.search-loading : Text {
                            text: "正在搜索…";
                            color: Theme.faint;
                            font-size: 13px;
                        }

                        if !root.search-text.is-empty && !root.search-loading && !root.search-active : Text {
                            text: "按回车或点击“搜索”开始检索。";
                            color: Theme.faint;
                            font-size: 13px;
                        }

                        if root.search-active && root.search-kind == "song" && root.search-tracks.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "歌曲"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for track in root.search-tracks : MediaRow {
                                    item: track;
                                    current: track.id == root.current-id;
                                    clicked => { root.play-track(track.id, "search"); }
                                }
                            }
                        }

                        if root.search-active && root.search-kind == "playlist" && root.search-playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "歌单"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.search-playlists.length * 192px;
                                content-height: self.height;
                                for item[index] in root.search-playlists : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.search-active && root.search-kind == "artist" && root.search-artists.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "歌手"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.search-artists : PlaylistRow {
                                    item: item;
                                    circle: true;
                                    clicked => { root.open-artist(item.id); }
                                }
                            }
                        }

                        if root.search-active && root.search-kind == "album" && root.search-albums.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "专辑"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.search-albums : PlaylistRow {
                                    item: item;
                                    clicked => { root.open-album(item.id); }
                                }
                            }
                        }

                        if root.search-active && root.search-kind == "lyric" && root.search-lyrics.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "歌词"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.search-lyrics : LyricResultRow {
                                    item: item;
                                    clicked => { root.play-track(item.track.id, "search-lyric"); }
                                }
                            }
                        }

                        if root.search-active
                            && ((root.search-kind == "song" && root.search-tracks.length == 0)
                                || (root.search-kind == "playlist" && root.search-playlists.length == 0)
                                || (root.search-kind == "artist" && root.search-artists.length == 0)
                                || (root.search-kind == "album" && root.search-albums.length == 0)
                                || (root.search-kind == "lyric" && root.search-lyrics.length == 0)) : Text {
                            text: "没有找到相关结果，换个关键词试试。";
                            color: Theme.faint;
                            font-size: 13px;
                        }
                    }
                }

                if root.page == "recent" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;
                            IconButton {
                                icon: @image-url("../assets/icons/arrow-left.svg");
                                icon-size: 18px;
                                width: 38px;
                                height: 38px;
                                border-radius: 19px;
                                background: Theme.overlay;
                                clicked => { root.nav("home"); }
                            }
                            Text { text: "最近播放"; color: Theme.text; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.recent-tracks.length == 0 : Text {
                            text: "还没有最近播放";
                            color: Theme.muted;
                            font-size: 13px;
                        }
                        VerticalLayout {
                            spacing: 6px;
                            for track in root.recent-tracks : MediaRow {
                                item: track;
                                current: track.id == root.current-id;
                                clicked => { root.play-track(track.id, "recent"); }
                            }
                        }
                    }
                }

                if root.page == "detail" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-bottom: 140px;
                        spacing: 0px;

                        Rectangle {
                            height: 430px;
                            clip: true;
                            background: root.detail-cover-tint;
                            Image {
                                visible: root.cover-accent && !root.low-power;
                                width: 100%;
                                height: 100%;
                                source: root.detail-backdrop;
                                image-fit: cover;
                                image-rendering: smooth;
                                opacity: 0.95;
                            }
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                // Two-stop only: multi-stop gradients can leave a
                                // 1px scanline in the software renderer.
                                background: @linear-gradient(180deg, #00000055 0%, #000000ee 100%);
                            }
                            IconButton {
                                x: 24px; y: 20px;
                                icon: @image-url("../assets/icons/arrow-left.svg");
                                icon-size: 18px;
                                width: 38px; height: 38px;
                                border-radius: 19px;
                                background: #00000033;
                                border-width: 1px;
                                border-color: #ffffff2e;
                                clicked => { root.back-detail(); }
                            }
                            if root.detail-kind == "playlist" && root.logged-in : PillButton {
                                x: parent.width - 132px;
                                y: 23px;
                                label: root.detail-subscribed ? "已收藏" : "收藏歌单";
                                width: 96px;
                                primary: root.detail-subscribed;
                                on-dark: !root.detail-subscribed;
                                clicked => { root.toggle-subscribe(); }
                            }
                            IconButton {
                                x: (root.detail-kind == "playlist" && root.logged-in) ? parent.width - 228px : parent.width - 96px;
                                y: 20px;
                                icon: @image-url("../assets/icons/share.svg");
                                icon-size: 16px;
                                width: 38px; height: 38px;
                                border-radius: 19px;
                                idle-background: #00000033;
                                hover-background: #ffffff26;
                                tint: #ffffff;
                                border-width: 1px;
                                border-color: #ffffff2e;
                                clicked => { root.detail-more-open = false; root.copy-detail-link(); }
                            }
                            IconButton {
                                x: (root.detail-kind == "playlist" && root.logged-in) ? parent.width - 182px : parent.width - 50px;
                                y: 20px;
                                icon: @image-url("../assets/icons/more.svg");
                                icon-size: 18px;
                                width: 38px; height: 38px;
                                border-radius: 19px;
                                idle-background: #00000033;
                                hover-background: #ffffff26;
                                tint: #ffffff;
                                border-width: 1px;
                                border-color: #ffffff2e;
                                clicked => { root.detail-more-open = !root.detail-more-open; }
                            }
                            if root.detail-more-open : Rectangle {
                                x: 0;
                                y: 0;
                                width: 100%;
                                height: 100%;
                                z: 20;
                                background: transparent;
                                more-scrim := TouchArea { clicked => { root.detail-more-open = false; } }
                            }
                            if root.detail-more-open : Rectangle {
                                x: (root.detail-kind == "playlist" && root.logged-in) ? parent.width - 302px : parent.width - 242px;
                                y: 64px;
                                width: 230px;
                                z: 30;
                                border-radius: 14px;
                                background: #17181af2;
                                border-width: 1px;
                                border-color: #ffffff1a;
                                clip: true;
                                drop-shadow-color: #000000a6;
                                drop-shadow-blur: 30px;
                                drop-shadow-offset-y: 10px;
                                TouchArea { }
                                VerticalLayout {
                                    padding: 6px;
                                    spacing: 1px;
                                    PlayerMenuItem {
                                        label: "复制链接";
                                        icon: @image-url("../assets/icons/share.svg");
                                        clicked => { root.detail-more-open = false; root.copy-detail-link(); }
                                    }
                                    PlayerMenuItem {
                                        label: "在浏览器打开";
                                        icon: @image-url("../assets/icons/expand.svg");
                                        clicked => { root.detail-more-open = false; root.open-detail-link(); }
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding-top: 70px;
                                Text {
                                    text: root.detail-title;
                                    color: #ffffff;
                                    font-size: 42px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.detail-meta;
                                    color: #ffffffa8;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.detail-description;
                                    color: #ffffff66;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    height: 40px;
                                    overflow: elide;
                                }
                            }
                            if (root.detail-kind == "playlist" || root.detail-kind == "daily") && root.detail-tracks.length > 0 : Rectangle {
                                x: (parent.width - 96px) / 2 - 84px;
                                y: 318px;
                                width: 64px;
                                height: 64px;
                                border-radius: 23px;
                                background: shuffle-tap.has-hover ? #ffffff2e : #ffffff14;
                                border-width: 1px;
                                border-color: #ffffff2e;
                                Glyph {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    source: @image-url("../assets/icons/shuffle.svg");
                                    glyph-size: 24px;
                                    tint: #ffffff;
                                }
                                shuffle-tap := TouchArea { clicked => { root.play-detail-shuffle(); } }
                            }
                            Rectangle {
                                x: (parent.width - 96px) / 2;
                                y: 318px;
                                width: 96px;
                                height: 64px;
                                border-radius: 23px;
                                background: detail-play-tap.has-hover ? #ffffff : #f5f4f2;
                                transform-scale-x: detail-play-tap.pressed ? 96% : (detail-play-tap.has-hover ? 102% : 100%);
                                transform-scale-y: detail-play-tap.pressed ? 96% : (detail-play-tap.has-hover ? 102% : 100%);
                                animate transform-scale-x, transform-scale-y { duration: 120ms; easing: ease-out; }
                                drop-shadow-color: #00000066;
                                drop-shadow-blur: 24px;
                                drop-shadow-offset-y: 8px;
                                Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/play-fill.svg"); glyph-size: 24px; tint: #111111; }
                                detail-play-tap := TouchArea {
                                    clicked => {
                                        if root.detail-first-id != "" {
                                            root.play-detail(root.detail-first-id);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            padding-top: 18px; padding-left: 30px; padding-right: 30px;
                            spacing: 8px;
                            if root.detail-tracks.length > 0 : Text {
                                text: "歌曲";
                                color: Theme.text;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            VerticalLayout {
                                spacing: 6px;
                                for track in root.detail-tracks : DetailRow {
                                    item: track;
                                    current: track.id == root.current-id;
                                    clicked => { root.play-detail(track.id); }
                                    more-clicked(x, y) => {
                                        root.detail-track-menu-id = track.id;
                                        root.detail-track-menu-text = track.title + " - " + track.artist;
                                        root.detail-track-menu-x = x;
                                        root.detail-track-menu-y = y;
                                    }
                                }
                            }
                        }

                        if root.detail-kind == "artist" && root.detail-albums.length > 0 : VerticalLayout {
                            padding-top: 18px; padding-left: 30px; padding-right: 30px;
                            spacing: 12px;
                            Text { text: "专辑"; color: Theme.text; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.detail-albums.length * 192px;
                                content-height: self.height;
                                for item[index] in root.detail-albums : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-album(item.id); }
                                }
                            }
                        }
                    }
                }

                if root.page == "settings" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 12px;
                            IconButton {
                                icon: @image-url("../assets/icons/close.svg");
                                icon-size: 17px;
                                width: 34px; height: 34px; border-radius: 17px;
                                background: Theme.overlay;
                                clicked => { root.nav("home"); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: min(980px, root.width - root.sidebar-width - 60px);
                                background: Theme.surface;
                                border-radius: 24px;
                            border-width: 1px;
                            border-color: Theme.border-soft;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 16px;
                                Text { text: "账户与设置"; color: Theme.text; font-size: 20px; font-weight: 700; horizontal-alignment: center; }

                                Rectangle {
                                    height: 88px;
                                    border-radius: 16px;
                                    background: Theme.surface-3;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 56px; height: 56px; border-radius: 28px;
                                            background: @linear-gradient(135deg, #7e838d, #3c4149);
                                            Text { text: root.account-initial; color: #fff; font-size: 18px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            alignment: center;
                                            Text { text: root.logged-in ? root.account-name : "网易云未登录"; color: Theme.text; font-size: 15px; font-weight: 600; overflow: elide; }
                                            Text { text: root.logged-in ? "UID " + root.account-id : "点击扫码登录"; color: Theme.muted; font-size: 11px; overflow: elide; }
                                        }
                                        if root.logged-in : PillButton { label: "退出登录"; clicked => { root.logout(); } }
                                        if !root.logged-in : PillButton { label: "登录"; primary: true; clicked => { root.login-open = true; root.refresh-qr(); } }
                                    }
                                }

                                Text { text: "个性化"; color: Theme.muted; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                SettingsToggleRow {
                                    title: "深色模式";
                                    description: "关闭后使用浅色界面；播放页和队列保持深色。";
                                    checked: root.dark-mode;
                                    toggled(value) => {
                                        root.dark-mode = value;
                                        root.set-theme(value ? "dark" : "light");
                                    }
                                }
                                SettingsToggleRow {
                                    title: "封面氛围背景";
                                    description: "在播放页和详情页显示当前封面的模糊氛围背景。";
                                    checked: root.cover-accent;
                                    toggled(value) => { root.set-cover-accent(value); }
                                }
                                SettingsToggleRow {
                                    title: "显示歌词翻译";
                                    description: "在歌词下方显示可用翻译。";
                                    checked: root.show-translation;
                                    toggled(value) => { root.set-show-translation(value); }
                                }
                                SettingsToggleRow {
                                    title: "性能模式";
                                    description: "关闭封面模糊等效果，降低低配电脑的占用。";
                                    checked: root.low-power;
                                    toggled(value) => { root.set-low-power(value); }
                                }

                                Text { text: "播放音质（下一首生效）"; color: Theme.muted; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton { label: "自动"; primary: root.quality == "auto"; clicked => { root.set-quality("auto"); } }
                                    PillButton { label: "标准"; primary: root.quality == "standard"; clicked => { root.set-quality("standard"); } }
                                    PillButton { label: "较高"; primary: root.quality == "higher"; clicked => { root.set-quality("higher"); } }
                                    PillButton { label: "极高"; primary: root.quality == "exhigh"; clicked => { root.set-quality("exhigh"); } }
                                    PillButton { label: "无损"; primary: root.quality == "lossless"; clicked => { root.set-quality("lossless"); } }
                                    PillButton { label: "Hi-Res"; primary: root.quality == "hires"; clicked => { root.set-quality("hires"); } }
                                }

                                Text { text: "日志级别"; color: Theme.muted; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton { label: "Debug"; primary: root.log-level == "debug"; clicked => { root.set-log-level("debug"); } }
                                    PillButton { label: "Info"; primary: root.log-level == "info"; clicked => { root.set-log-level("info"); } }
                                    PillButton { label: "Warn"; primary: root.log-level == "warn"; clicked => { root.set-log-level("warn"); } }
                                    PillButton { label: "Error"; primary: root.log-level == "error"; clicked => { root.set-log-level("error"); } }
                                    PillButton { label: "关闭"; primary: root.log-level == "none"; clicked => { root.set-log-level("none"); } }
                                }

                                Text { text: "数据与日志"; color: Theme.muted; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                Rectangle {
                                    height: 64px;
                                    border-radius: 16px;
                                    background: Theme.surface-3;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        cross-axis-alignment: center;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            alignment: center;
                                            Text { text: "数据目录"; color: Theme.muted; font-size: 10px; }
                                            Text { text: root.data-dir; color: Theme.text-soft; font-size: 11px; overflow: elide; }
                                        }
                                        PillButton { label: "打开日志目录"; width: 120px; clicked => { root.open-log-folder(); } }
                                    }
                                }

                                Text { text: "Decro 0.4.4 · Slint 原生版 · 数据便携"; color: Theme.faint; font-size: 10px; horizontal-alignment: center; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }

    // ── Dock ─────────────────────────────────────────────────────────────
    Rectangle {
        visible: !root.player-open;
        x: root.sidebar-width + 26px;
        y: root.height - root.dock-height - 18px;
        width: root.width - root.sidebar-width - 52px;
        height: root.dock-height;
        z: 30;
        border-radius: 26px;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.border;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 22px;
            spacing: 14px;
            cross-axis-alignment: center;

            dock-cover := Rectangle {
                width: 62px;
                height: 62px;
                border-radius: 16px;
                background: root.current-cover;
                clip: true;
                drop-shadow-color: #0000003d;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;
                Image {
                    width: 100%; height: 100%;
                    source: root.current-cover-image;
                    image-fit: cover;
                    transform-scale-x: dock-cover-tap.has-hover && !root.cover-flying ? 104% : 100%;
                    transform-scale-y: dock-cover-tap.has-hover && !root.cover-flying ? 104% : 100%;
                    animate transform-scale-x, transform-scale-y { duration: 180ms; }
                }
                if root.current-cover-image.width == 0 : Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    text: "♪";
                    color: #ffffff88;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    visible: dock-cover-tap.has-hover;
                    x: 0; y: 0; width: 100%; height: 100%;
                    background: #00000066;
                    Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/expand.svg"); glyph-size: 18px; tint: #fff; }
                }
                dock-cover-tap := TouchArea { clicked => { root.detail-track-menu-id = ""; root.open-player(); } }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 62px;
                background: transparent;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text { text: root.current-title; color: Theme.text; font-size: 16px; font-weight: 550; overflow: elide; }
                    Text { text: root.current-artist; color: Theme.muted; font-size: 13px; overflow: elide; }
                }
                TouchArea { clicked => { root.detail-track-menu-id = ""; root.open-player(); } }
            }

            dock-play := RoundIconButton {
                icon: root.loading ? @image-url("../assets/icons/more.svg") : (root.playing ? @image-url("../assets/icons/pause-fill.svg") : @image-url("../assets/icons/play-fill.svg"));
                icon-size: 22px;
                button-size: 40px;
                background-color: transparent;
                clicked => { root.toggle-play(); }
            }
            dock-next := RoundIconButton {
                icon: @image-url("../assets/icons/next.svg");
                icon-size: 20px;
                button-size: 40px;
                background-color: transparent;
                clicked => { root.next(); }
            }
        }

        Rectangle {
            x: 10px;
            y: parent.height - 6px;
            width: parent.width - 20px;
            height: 2px;
            border-radius: 1px;
            background: Theme.border-strong;
            clip: true;
            Rectangle {
                // Explicit left origin: a child Rectangle with only a width is
                // centered by default, which made the dock progress grow from
                // the middle towards both sides.
                x: 0;
                y: 0;
                width: root.duration > 0 ? min(parent.width, parent.width * max(0, min(1, root.progress / root.duration))) : 0px;
                height: 100%;
                border-radius: 1px;
                background: #ff645d;
                // No width animation: while minimized progress updates are
                // paused, so restoring would otherwise animate from the old
                // (often zero) width to the current position.
            }
        }
    }

    // ── Toast ────────────────────────────────────────────────────────────
    if root.status-text != "" && !root.player-open : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 146px;
        width: min(root.width - 80px, 560px);
        height: 34px;
        z: 29;
        border-radius: 17px;
        background: Theme.dark ? #1b1c1ee8 : #ffffffe8;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 5px;
        Text {
            x: 16px; y: 0;
            width: parent.width - 32px;
            height: parent.height;
            text: root.status-text;
            color: Theme.text-soft;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ── Playlist dialog ──────────────────────────────────────────────────
    if root.playlist-dialog-open : Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        z: 190;
        background: #000000b8;
        TouchArea { clicked => { root.close-playlist-dialog(); } }
        Rectangle {
            width: 440px;
            height: root.playlist-dialog-mode == "create" ? 268px : 300px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 24px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            TouchArea { }
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 50px;
            drop-shadow-offset-y: 18px;
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Text {
                        horizontal-stretch: 1;
                        text: root.playlist-dialog-mode == "create" ? "新建歌单" : "添加歌单";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    IconButton {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 14px;
                        width: 30px; height: 30px; border-radius: 15px;
                        background: Theme.overlay;
                        clicked => { root.close-playlist-dialog(); }
                    }
                }
                Text {
                    text: root.playlist-dialog-mode == "create"
                        ? "给新歌单起一个名字。"
                        : "输入歌单 ID 或网易云歌单链接，添加到资料库。";
                    color: Theme.muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                TextField {
                    text <=> root.playlist-dialog-text;
                    placeholder: root.playlist-dialog-mode == "create" ? "歌单名称" : "歌单 ID 或链接";
                    autofocus: true;
                    accepted => { root.submit-playlist-dialog(root.playlist-dialog-text); }
                }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        label: "取消";
                        width: 84px;
                        clicked => { root.close-playlist-dialog(); }
                    }
                    PillButton {
                        label: root.playlist-dialog-mode == "create" ? "创建" : "添加";
                        width: 84px;
                        primary: true;
                        disabled: root.playlist-dialog-text.is-empty;
                        clicked => { root.submit-playlist-dialog(root.playlist-dialog-text); }
                    }
                }
            }
        }
    }

    // ── Detail track context menu ────────────────────────────────────────
    if root.page == "detail" && root.detail-track-menu-id != "" : Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        z: 150;
        background: transparent;
        track-menu-scrim := TouchArea { clicked => { root.detail-track-menu-id = ""; } }
    }
    if root.page == "detail" && root.detail-track-menu-id != "" : Rectangle {
        x: min(max(8px, root.detail-track-menu-x - 154px), root.width - 206px);
        y: min(max(8px, root.detail-track-menu-y + 30px), root.height - 164px);
        width: 198px;
        z: 151;
        border-radius: 14px;
        background: #17181af2;
        border-width: 1px;
        border-color: #ffffff1a;
        clip: true;
        drop-shadow-color: #000000a6;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        TouchArea { }
        VerticalLayout {
            padding: 6px;
            spacing: 1px;
            PlayerMenuItem {
                label: "播放";
                icon: @image-url("../assets/icons/play-fill.svg");
                clicked => {
                    root.play-detail(root.detail-track-menu-id);
                    root.detail-track-menu-id = "";
                }
            }
            PlayerMenuItem {
                label: "喜欢 / 取消喜欢";
                icon: @image-url("../assets/icons/star.svg");
                clicked => {
                    root.toggle-track-like(root.detail-track-menu-id);
                    root.detail-track-menu-id = "";
                }
            }
            PlayerMenuItem {
                label: "复制歌曲信息";
                icon: @image-url("../assets/icons/copy.svg");
                clicked => {
                    root.copy-song-info(root.detail-track-menu-text);
                    root.detail-track-menu-id = "";
                }
            }
        }
    }

    // Forces a full-window repaint after Windows restores a minimized window.
    Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        z: 500;
        background: root.repaint-nudge ? #00000002 : #00000001;
    }

    // ── Login modal ──────────────────────────────────────────────────────
    if root.login-open && !root.logged-in : Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        z: 200;
        background: #000000cc;
        TouchArea { }
        Rectangle {
            width: 420px;
            height: 650px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 28px;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-color: #000000b3;
            drop-shadow-blur: 50px;
            drop-shadow-offset-y: 20px;
            VerticalLayout {
                padding: 26px;
                spacing: 13px;
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text { text: "登录网易云音乐"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    IconButton {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 15px;
                        width: 30px; height: 30px; border-radius: 15px;
                        background: Theme.overlay;
                        clicked => { root.close-login(); }
                    }
                }
                Text { text: "打开网易云音乐 App 扫码登录"; color: Theme.muted; font-size: 12px; }
                Rectangle {
                    height: 280px;
                    border-radius: 18px;
                    background: #f5f5f5;
                    Image { width: 100%; height: 100%; source: root.qr-image; image-fit: contain; }
                }
                Text {
                    text: root.status-text;
                    color: Theme.muted;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    min-height: 30px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    PillButton { label: "刷新二维码"; primary: true; clicked => { root.refresh-qr(); } }
                    PillButton { label: "关闭"; clicked => { root.close-login(); } }
                }
                TextField {
                    text <=> root.cookie-text;
                    placeholder: "或粘贴网页版 MUSIC_U Cookie";
                    accepted => { root.import-cookie(root.cookie-text); }
                }
                PillButton {
                    label: "导入 Cookie";
                    width: 100%;
                    clicked => { root.import-cookie(root.cookie-text); }
                }
            }
        }
    }

    // ── Full player ──────────────────────────────────────────────────────
    if root.player-visible : Rectangle {
        x: 0;
        y: root.titlebar-height;
        width: root.width;
        height: root.height - root.titlebar-height;
        z: 40;
        background: #090a0c;
        clip: true;
        opacity: root.player-open ? 1 : 0;
        animate opacity { duration: 220ms; easing: ease-out; }

        Image {
            visible: root.cover-accent && !root.low-power;
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            source: root.current-backdrop;
            image-fit: cover;
            image-rendering: smooth;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            // Two-stop only: see the FeatureCard note above.
            background: @linear-gradient(180deg, #08090b40 0%, #08090bdd 100%);
        }
        Rectangle {
            x: -160px;
            y: root.height - 620px;
            width: 780px;
            height: 780px;
            visible: !root.low-power;
            background: @radial-gradient(circle, #c9202722 0%, #c9202700 70%);
        }
        TouchArea { enabled: root.player-open; }

        VerticalLayout {
            padding-top: 16px; padding-bottom: 18px; padding-left: 40px; padding-right: 40px;
            spacing: 0px;

            // Player top bar
            HorizontalLayout {
                height: 44px;
                spacing: 12px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 36px; height: 36px; border-radius: 18px;
                    background: player-close-tap.has-hover ? #ffffff1c : #ffffff0d;
                    border-width: 1px;
                    border-color: #ffffff1a;
                    Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/chevron-down.svg"); glyph-size: 16px; tint: #ffffffb3; }
                    player-close-tap := TouchArea { clicked => { root.player-menu-open = false; root.close-player(); } }
                }
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #ff645d; }
                Text { text: "正在播放"; color: #ffffff94; font-size: 10px; font-weight: 650; letter-spacing: 1px; vertical-alignment: center; }
                Text { text: "网易云音乐"; color: #ffffff4d; font-size: 10px; vertical-alignment: center; }
                Text {
                    horizontal-stretch: 1;
                    text: root.status-text;
                    color: #ff9a94;
                    font-size: 10px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Rectangle {
                    height: 22px;
                    width: 54px;
                    border-radius: 5px;
                    background: #7aa9f01a;
                    border-width: 1px;
                    border-color: #7aa9f033;
                    Text { text: root.current-quality; color: #9fc0f5; font-size: 9px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
                if root.lyrics-mode : PillButton { label: "显示封面"; clicked => { root.lyrics-mode = false; } }
            }

            // Body/lyrics get all remaining height; the transport below keeps
            // its preferred height so the progress bar stays at the same
            // position in both cover and lyrics modes.
            Rectangle {
                vertical-stretch: 1;
                background: transparent;

                // Player body
                if !root.lyrics-mode : HorizontalLayout {
                vertical-stretch: 1;
                padding-top: 10px; padding-bottom: 10px; padding-left: 28px; padding-right: 28px;
                spacing: 70px;
                cross-axis-alignment: center;

                VerticalLayout {
                    width: 40%;
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: 14px;
                    player-cover := Rectangle {
                        init => {
                            if (self.absolute-position.x != 0px || self.absolute-position.y != 0px) {
                                root.player-cover-target-x = self.absolute-position.x;
                                root.player-cover-target-y = self.absolute-position.y;
                            }
                            root.player-cover-target-w = self.width;
                            root.player-cover-target-h = self.height;
                        }
                        changed absolute-position => {
                            root.player-cover-target-x = self.absolute-position.x;
                            root.player-cover-target-y = self.absolute-position.y;
                        }
                        changed width => { root.player-cover-target-w = self.width; }
                        changed height => { root.player-cover-target-h = self.height; }
                        visible: !root.cover-flying;
                        width: root.player-cover-size;
                        height: root.player-cover-size;
                        border-radius: 24px;
                        background: root.current-cover;
                        clip: true;
                        drop-shadow-color: #00000073;
                        drop-shadow-blur: 54px;
                        drop-shadow-offset-y: 24px;
                        Image {
                            width: 100%; height: 100%;
                            source: root.current-cover-image;
                            image-fit: cover;
                            transform-scale-x: cover-tap.has-hover ? 103% : 100%;
                            transform-scale-y: cover-tap.has-hover ? 103% : 100%;
                            animate transform-scale-x, transform-scale-y { duration: 380ms; }
                        }
                        if root.current-cover-image.width == 0 : Text {
                            x: 0; y: 0; width: 100%; height: 100%;
                            text: "♪";
                            color: #ffffff66;
                            font-size: 70px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(180deg, #00000000 55%, #00000055 100%);
                        }
                        Text {
                            x: 18px;
                            y: parent.height - 28px;
                            text: root.current-album + " · 网易云音乐";
                            color: #ffffffa8;
                            font-size: 9px;
                            overflow: elide;
                        }
                        Rectangle {
                            visible: cover-tap.has-hover;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 130px;
                            height: 38px;
                            border-radius: 19px;
                            background: #00000052;
                            border-width: 1px;
                            border-color: #ffffff2e;
                            Text { text: "查看歌词"; color: #ffffffd9; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        cover-tap := TouchArea { clicked => { root.lyrics-mode = true; } }
                        // The album label sits on top of the full-cover hit area;
                        // clicking it opens the album instead of switching to lyrics.
                        cover-album-tap := TouchArea {
                            x: 12px;
                            y: parent.height - 32px;
                            width: parent.width - 24px;
                            height: 26px;
                            enabled: root.current-album-id != "";
                            mouse-cursor: pointer;
                            clicked => {
                                root.close-player();
                                root.open-album(root.current-album-id);
                            }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 14px;
                        cross-axis-alignment: center;
                        Text {
                            horizontal-stretch: 1;
                            text: root.current-title;
                            color: #ffffff;
                            font-size: 42px;
                            font-weight: 700;
                            overflow: elide;
                            horizontal-alignment: left;
                        }
                        RoundIconButton {
                            icon: @image-url("../assets/icons/star.svg");
                            icon-size: 20px;
                            button-size: 44px;
                            background-color: root.current-liked ? #ffffff1f : #ffffff0d;
                            tint: root.current-liked ? #ff645d : #ffffff;
                            clicked => { root.toggle-like(); }
                        }
                        RoundIconButton {
                            icon: @image-url("../assets/icons/more.svg");
                            icon-size: 22px;
                            button-size: 44px;
                            background-color: root.player-menu-open ? #ffffff1f : #ffffff0d;
                            tint: #ffffff;
                            clicked => { root.player-menu-open = !root.player-menu-open; }
                        }
                    }
                    HorizontalLayout {
                        height: 22px;
                        spacing: 0px;
                        for artist[index] in root.current-artists : HorizontalLayout {
                            spacing: 0px;
                            if index > 0 : Text {
                                text: " / ";
                                color: #ffffff9e;
                                font-size: 16px;
                                vertical-alignment: center;
                            }
                            InlineLink {
                                label: artist.name;
                                font-size: 16px;
                                idle-color: #ffffff9e;
                                interactive: artist.id != "";
                                clicked => {
                                    root.close-player();
                                    root.open-artist(artist.id);
                                }
                            }
                        }
                        if root.current-artists.length == 0 : Text {
                            text: root.current-artist;
                            color: #ffffff9e;
                            font-size: 16px;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Rectangle { height: 16px; }
                    HorizontalLayout {
                        height: 20px;
                        spacing: 0px;
                        InlineLink {
                            label: "\"" + root.current-album + "\"";
                            font-size: 14px;
                            idle-color: #ffffff85;
                            interactive: root.current-album-id != "";
                            clicked => {
                                root.close-player();
                                root.open-album(root.current-album-id);
                            }
                        }
                        Text {
                            text: " · ";
                            color: #ffffff85;
                            font-size: 14px;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        for artist[index] in root.current-artists : HorizontalLayout {
                            spacing: 0px;
                            if index > 0 : Text {
                                text: " / ";
                                color: #ffffff85;
                                font-size: 14px;
                                horizontal-stretch: 0;
                                vertical-alignment: center;
                            }
                            InlineLink {
                                label: artist.name;
                                font-size: 14px;
                                idle-color: #ffffff85;
                                interactive: artist.id != "";
                                clicked => {
                                    root.close-player();
                                    root.open-artist(artist.id);
                                }
                            }
                        }
                        if root.current-artists.length == 0 : Text {
                            text: root.current-artist;
                            color: #ffffff85;
                            font-size: 14px;
                            horizontal-stretch: 0;
                            overflow: elide;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    Text {
                        text: root.current-quality + " · 网易云音乐";
                        color: #ffffff57;
                        font-size: 10px;
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        PillButton {
                            label: "打开歌词";
                            width: 104px;
                            clicked => { root.lyrics-mode = true; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                }

                if root.lyrics-mode : VerticalLayout {
                vertical-stretch: 1;
                padding-top: 8px; padding-left: 100px; padding-right: 100px;
                spacing: 0px;
                Text { text: root.current-title; color: #fff; font-size: 40px; font-weight: 700; overflow: elide; }
                HorizontalLayout {
                    height: 22px;
                    spacing: 0px;
                    for artist[index] in root.current-artists : HorizontalLayout {
                        spacing: 0px;
                        if index > 0 : Text {
                            text: " / ";
                            color: #ffffff9e;
                            font-size: 16px;
                            horizontal-stretch: 0;
                            vertical-alignment: center;
                        }
                        InlineLink {
                            label: artist.name;
                            font-size: 16px;
                            idle-color: #ffffff9e;
                            interactive: artist.id != "";
                            clicked => {
                                root.close-player();
                                root.open-artist(artist.id);
                            }
                        }
                    }
                    if root.current-artists.length == 0 : Text {
                        text: root.current-artist;
                        color: #ffffff9e;
                        font-size: 16px;
                        horizontal-stretch: 0;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.lyric-follow ? "滚轮或拖动查看，点击歌词跳转" : "已暂停自动跟随"; color: #ffffff5c; font-size: 10px; vertical-alignment: center; }
                    if !root.lyric-follow : PillButton {
                        label: "回到当前";
                        clicked => {
                            root.lyric-follow = true;
                            root.lyric-scroll-y = root.lyric-target-y;
                        }
                    }
                }
                LyricView {
                    vertical-stretch: 1;
                    lines: root.lyrics;
                    current: root.lyric-index;
                    line-height: root.lyric-line-height;
                    verse-padding: root.lyric-padding;
                    show-translation: root.show-translation;
                    scroll-target <=> root.lyric-scroll-y;
                    height-changed(value) => {
                        root.lyric-view-height = value;
                        if (root.lyric-follow) {
                            root.lyric-scroll-y = root.lyric-target-y;
                        }
                    }
                    user-scrolled(value) => {
                        root.lyric-follow = false;
                        root.lyric-scroll-y = value;
                    }
                    line-clicked(index, time) => {
                        root.lyric-follow = true;
                        root.lyric-scroll-y = root.lyric-y-for(index);
                        root.seek-lyric(time);
                    }
                }
                }
            }

            // Transport / progress
            VerticalLayout {
                // Layout elements default to a stretch factor; keep the
                // transport at its preferred height so the seek bar sits just
                // above the controls in both cover and lyrics modes.
                vertical-stretch: 0;
                spacing: 4px;
                SeekBar {
                    value: root.progress;
                    maximum: root.duration;
                    playing: root.playing && !root.window-minimized;
                    low-power: root.low-power;
                    seek(value) => { root.seek(value); }
                }
                HorizontalLayout {
                    Text { text: root.position-text; color: #ffffff7a; font-size: 12px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.duration-text; color: #ffffff7a; font-size: 12px; }
                }
                HorizontalLayout {
                    height: 68px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    HorizontalLayout {
                        width: 220px;
                        spacing: 6px;
                        alignment: start;
                        cross-axis-alignment: center;
                        RoundIconButton {
                            icon: @image-url("../assets/icons/lyrics.svg");
                            icon-size: 18px;
                            button-size: 36px;
                            background-color: root.lyrics-mode ? #ffffff1f : transparent;
                            clicked => { root.lyrics-mode = !root.lyrics-mode; }
                        }
                        RoundIconButton {
                            icon: @image-url("../assets/icons/queue.svg");
                            icon-size: 18px;
                            button-size: 36px;
                            background-color: root.queue-open ? #ffffff1f : transparent;
                            clicked => { root.toggle-queue(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 22px;
                        cross-axis-alignment: center;
                        RoundIconButton {
                            icon: @image-url("../assets/icons/prev.svg");
                            icon-size: 22px;
                            button-size: 62px;
                            clicked => { root.prev(); }
                        }
                        player-play := Rectangle {
                            init => {
                                if (self.absolute-position.x != 0px || self.absolute-position.y != 0px) {
                                    root.player-play-target-x = self.absolute-position.x;
                                    root.player-play-target-y = self.absolute-position.y;
                                }
                                root.player-play-target-w = self.width;
                                root.player-play-target-h = self.height;
                            }
                            changed absolute-position => {
                                root.player-play-target-x = self.absolute-position.x;
                                root.player-play-target-y = self.absolute-position.y;
                            }
                            changed width => { root.player-play-target-w = self.width; }
                            changed height => { root.player-play-target-h = self.height; }
                            opacity: root.controls-ready ? 1 : 0;
                            animate opacity { duration: 80ms; }
                            width: 96px;
                            height: 64px;
                            border-radius: 23px;
                            background: play-tap.has-hover ? #ffffff : #f5f4f2;
                            transform-scale-x: play-tap.pressed ? 96% : (play-tap.has-hover ? 102% : 100%);
                            transform-scale-y: play-tap.pressed ? 96% : (play-tap.has-hover ? 102% : 100%);
                            animate background { duration: 140ms; }
                            animate transform-scale-x, transform-scale-y { duration: 120ms; easing: ease-out; }
                            Glyph {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.loading ? @image-url("../assets/icons/more.svg") : (root.playing ? @image-url("../assets/icons/pause-fill.svg") : @image-url("../assets/icons/play-fill.svg"));
                                glyph-size: 24px;
                                tint: #111111;
                            }
                            play-tap := TouchArea {
                                enabled: root.player-open && root.controls-ready;
                                clicked => { root.toggle-play(); }
                            }
                        }
                        player-next := Rectangle {
                            init => {
                                if (self.absolute-position.x != 0px || self.absolute-position.y != 0px) {
                                    root.player-next-target-x = self.absolute-position.x;
                                    root.player-next-target-y = self.absolute-position.y;
                                }
                                root.player-next-target-w = self.width;
                                root.player-next-target-h = self.height;
                            }
                            changed absolute-position => {
                                root.player-next-target-x = self.absolute-position.x;
                                root.player-next-target-y = self.absolute-position.y;
                            }
                            changed width => { root.player-next-target-w = self.width; }
                            changed height => { root.player-next-target-h = self.height; }
                            width: 62px;
                            height: 62px;
                            opacity: root.controls-ready ? 1 : 0;
                            animate opacity { duration: 80ms; }
                            RoundIconButton {
                                icon: @image-url("../assets/icons/next.svg");
                                icon-size: 22px;
                                button-size: 62px;
                                enabled: root.player-open && root.controls-ready;
                                clicked => { root.next(); }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        width: 220px;
                        spacing: 8px;
                        alignment: end;
                        cross-axis-alignment: center;
                        Glyph { source: @image-url("../assets/icons/volume.svg"); glyph-size: 18px; tint: #ffffff80; }
                        VolumeBar {
                            value <=> root.volume;
                            changed(value) => { root.volume-changed(value); }
                            released => { root.volume-released(root.volume); }
                        }
                    }
                }
            }
        }

        // Player "more" menu
        if root.player-menu-open : Rectangle {
            width: 100%;
            height: 100%;
            z: 64;
            background: transparent;
            menu-scrim := TouchArea { clicked => { root.player-menu-open = false; } }
        }
        if root.player-menu-open : Rectangle {
            x: root.width - 304px;
            y: 66px;
            width: 268px;
            z: 65;
            border-radius: 18px;
            background: #17181af2;
            border-width: 1px;
            border-color: #ffffff1a;
            clip: true;
            drop-shadow-color: #000000a6;
            drop-shadow-blur: 36px;
            drop-shadow-offset-y: 12px;
            TouchArea { }
            VerticalLayout {
                padding: 7px;
                spacing: 1px;
                Text {
                    text: "歌曲操作";
                    color: #ffffff66;
                    font-size: 9px;
                    font-weight: 650;
                    letter-spacing: 1px;
                    height: 22px;
                    vertical-alignment: center;
                }
                if root.current-artists.length > 1 : Text {
                    text: "查看歌手";
                    color: #ffffff66;
                    font-size: 9px;
                    font-weight: 650;
                    letter-spacing: 1px;
                    height: 22px;
                    vertical-alignment: center;
                }
                for artist in root.current-artists : PlayerMenuItem {
                    label: root.current-artists.length > 1 ? artist.name : "查看歌手";
                    icon: @image-url("../assets/icons/user.svg");
                    enabled: artist.id != "";
                    clicked => {
                        root.player-menu-open = false;
                        root.close-player();
                        root.open-artist(artist.id);
                    }
                }
                if root.current-artists.length == 0 : PlayerMenuItem {
                    label: "查看歌手";
                    icon: @image-url("../assets/icons/user.svg");
                    enabled: false;
                }
                PlayerMenuItem {
                    label: "查看专辑";
                    icon: @image-url("../assets/icons/disc.svg");
                    enabled: root.current-album-id != "";
                    clicked => {
                        root.player-menu-open = false;
                        root.close-player();
                        root.open-album(root.current-album-id);
                    }
                }
                PlayerMenuItem {
                    label: "复制歌曲信息";
                    icon: @image-url("../assets/icons/copy.svg");
                    clicked => {
                        root.player-menu-open = false;
                        root.copy-song-info(root.current-title + " - " + root.current-artist);
                    }
                }
                Rectangle { height: 1px; background: #ffffff12; }
                Text {
                    text: "单曲音质";
                    color: #ffffff66;
                    font-size: 9px;
                    font-weight: 650;
                    letter-spacing: 1px;
                    height: 22px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;
                    PlayerQualityChip {
                        horizontal-stretch: 1;
                        label: "跟随全局";
                        active: root.current-track-quality == "";
                        clicked => { root.player-menu-open = false; root.set-track-quality(""); }
                    }
                    PlayerQualityChip {
                        horizontal-stretch: 1;
                        label: "自动";
                        active: root.current-track-quality == "auto";
                        clicked => { root.player-menu-open = false; root.set-track-quality("auto"); }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;
                    PlayerQualityChip { horizontal-stretch: 1; label: "标准"; active: root.current-track-quality == "standard"; clicked => { root.player-menu-open = false; root.set-track-quality("standard"); } }
                    PlayerQualityChip { horizontal-stretch: 1; label: "较高"; active: root.current-track-quality == "higher"; clicked => { root.player-menu-open = false; root.set-track-quality("higher"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;
                    PlayerQualityChip { horizontal-stretch: 1; label: "极高"; active: root.current-track-quality == "exhigh"; clicked => { root.player-menu-open = false; root.set-track-quality("exhigh"); } }
                    PlayerQualityChip { horizontal-stretch: 1; label: "无损"; active: root.current-track-quality == "lossless"; clicked => { root.player-menu-open = false; root.set-track-quality("lossless"); } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;
                    PlayerQualityChip { horizontal-stretch: 1; label: "Hi-Res"; active: root.current-track-quality == "hires"; clicked => { root.player-menu-open = false; root.set-track-quality("hires"); } }
                }
                Rectangle { height: 4px; }
            }
        }

        // Play queue
        if root.queue-open : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000033;
            queue-scrim := TouchArea { clicked => { root.queue-open = false; } }
        }
        if root.queue-open : Rectangle {
            x: root.width - 372px;
            y: 70px;
            width: 332px;
            height: parent.height - self.y - 160px;
            z: 60;
            border-radius: 22px;
            background: #17181aee;
            border-width: 1px;
            border-color: #ffffff1a;
            clip: true;
            TouchArea { }
            drop-shadow-color: #0000008c;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text { text: "播放队列"; color: #f5f5f7; font-size: 17px; font-weight: 700; }
                        Text { text: root.queue-tracks.length + " 首"; color: #8e8e93; font-size: 10px; }
                    }
                    IconButton {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 14px;
                        width: 30px; height: 30px; border-radius: 15px;
                        idle-background: #ffffff0d;
                        hover-background: #ffffff1c;
                        tint: #ffffff;
                        clicked => { root.queue-open = false; }
                    }
                }
                ListView {
                    vertical-stretch: 1;
                    for track[index] in root.queue-tracks : Rectangle {
                        width: parent.width;
                        height: 54px;
                        border-radius: 12px;
                        background: index == root.queue-index ? #c9202733 : (queue-row-tap.has-hover ? #ffffff0d : transparent);
                        HorizontalLayout {
                            padding: 7px;
                            spacing: 10px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 38px; height: 38px; border-radius: 9px;
                                background: track.tint;
                                clip: true;
                                Image { width: 100%; height: 100%; source: track.cover; image-fit: cover; }
                                if track.cover.width == 0 : Text {
                                    x: 0; y: 0; width: 100%; height: 100%;
                                    text: "♪"; color: #ffffff77; font-size: 15px;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                alignment: center;
                                Text { text: track.title; color: index == root.queue-index ? #ff8a84 : #f5f5f7; font-size: 12px; font-weight: 600; overflow: elide; }
                                Text { text: track.artist; color: #8e8e93; font-size: 10px; overflow: elide; }
                            }
                            Text { text: track.duration; color: #77777d; font-size: 9px; vertical-alignment: center; }
                        }
                        queue-row-tap := TouchArea { clicked => { root.play-queue(index); } }
                    }
                }
            }
        }
        // During the open/close fade `player-open` may be false while the
        // player is still visible. `opacity` does not affect hit testing, so
        // block the fading player's invisible controls (and the workspace
        // underneath) until the panel is actually removed.
        if root.player-visible && !root.player-open : Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            z: 70;
            background: transparent;
            TouchArea { }
        }
    }

    // ── Flying cover between the dock and the player ─────────────────────
    Rectangle {
        visible: root.cover-flying;
        z: 45;
        x: root.player-open ? root.player-cover-target-x : dock-cover.absolute-position.x;
        y: root.player-open ? root.player-cover-target-y : dock-cover.absolute-position.y;
        width: root.player-open ? root.player-cover-target-w : dock-cover.width;
        height: root.player-open ? root.player-cover-target-h : dock-cover.height;
        border-radius: root.player-open ? 24px : 16px;
        background: root.current-cover;
        clip: true;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        Image { width: 100%; height: 100%; source: root.current-cover-image; image-fit: cover; image-rendering: smooth; }
        if root.current-cover-image.width == 0 : Text {
            x: 0; y: 0; width: 100%; height: 100%;
            text: "♪";
            color: #ffffff88;
            font-size: root.player-open ? 60px : 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        animate x, y, width, height, border-radius { duration: 380ms; easing: ease-out; }
    }

    // Play / next morph between the dock and the full player.
    FlyingControl {
        visible: root.cover-flying;
        z: 46;
        tx: root.player-open ? root.player-play-target-x : dock-play.absolute-position.x;
        ty: root.player-open ? root.player-play-target-y : dock-play.absolute-position.y;
        tw: root.player-open ? root.player-play-target-w : dock-play.width;
        th: root.player-open ? root.player-play-target-h : dock-play.height;
        icon: root.loading ? @image-url("../assets/icons/more.svg") : (root.playing ? @image-url("../assets/icons/pause-fill.svg") : @image-url("../assets/icons/play-fill.svg"));
        icon-size: root.player-open ? 24px : 22px;
        tint: root.player-open ? #111111 : #ffffff;
        fill: root.player-open ? #f5f4f2 : transparent;
        corner: root.player-open ? 23px : 20px;
    }
    FlyingControl {
        visible: root.cover-flying;
        z: 46;
        tx: root.player-open ? root.player-next-target-x : dock-next.absolute-position.x;
        ty: root.player-open ? root.player-next-target-y : dock-next.absolute-position.y;
        tw: root.player-open ? root.player-next-target-w : dock-next.width;
        th: root.player-open ? root.player-next-target-h : dock-next.height;
        icon: @image-url("../assets/icons/next.svg");
        icon-size: root.player-open ? 22px : 20px;
        tint: #ffffff;
        fill: root.player-open ? #ffffff21 : transparent;
        corner: root.player-open ? 31px : 20px;
    }

}
