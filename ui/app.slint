import { Button, LineEdit, ListView, ScrollView, Slider } from "std-widgets.slint";

export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    meta: string,
    duration: string,
    quality: string,
    cover: image,
    tint: color,
}

export struct PlaylistItem {
    id: string,
    title: string,
    meta: string,
    cover: image,
    tint: color,
}

export struct LyricItem {
    time: float,
    text: string,
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 38px;
    width: 86px;
    border-radius: 12px;
    background: active ? #c92027 : (tap.has-hover ? #ffffff0d : transparent);
    animate background { duration: 160ms; }
    Text {
        text: root.label;
        color: root.active ? #fff : (tap.has-hover ? #d4d4d9 : #9a9a9f);
        font-size: 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 160ms; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 86px;
    height: 34px;
    border-radius: 17px;
    background: root.active ? #c92027 : #1b1b1e;
    border-width: 1px;
    border-color: root.active ? #c92027 : #2c2c30;
    Text { text: root.label; color: root.active ? #ffffff : #b7b7bd; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

component DockIconButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> primary;
    callback clicked();
    width: root.primary ? 42px : 34px;
    height: root.primary ? 42px : 34px;
    border-radius: self.width / 2;
    background: root.primary ? (tap.has-hover ? #ffffff : #ececef) : (tap.has-hover ? #ffffff1a : #ffffff0a);
    border-width: root.primary ? 0px : 1px;
    border-color: #ffffff14;
    animate background { duration: 150ms; }
    Text {
        text: root.glyph;
        color: root.primary ? #17171a : #e6e6ea;
        font-size: root.primary ? 16px : 14px;
        horizontal-alignment: center;
        vertical-alignment: center;
        animate color { duration: 150ms; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component DockPill inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 32px;
    width: 52px;
    border-radius: 16px;
    background: tap.has-hover ? #ffffff1c : #ffffff0a;
    border-width: 1px;
    border-color: #ffffff16;
    animate background { duration: 150ms; }
    Text { text: root.label; color: #dedee3; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component TrackRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> current;
    callback clicked();
    height: 64px;
    border-radius: 12px;
    clip: true;
    background: current ? #2a1719 : (tap.has-hover ? #202024 : #171719);
    animate background { duration: 160ms; }
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        Rectangle {
            width: 48px;
            height: 48px;
            border-radius: 8px;
            background: root.item.tint;
            clip: true;
            Image {
                width: 100%; height: 100%;
                source: root.item.cover;
                image-fit: cover;
                transform-scale-x: tap.has-hover ? 105% : 100%;
                transform-scale-y: tap.has-hover ? 105% : 100%;
                animate transform-scale-x, transform-scale-y { duration: 180ms; }
            }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff88;
                font-size: 18px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.item.title; color: #f1f1f2; font-size: 14px; overflow: elide; }
            Text { text: root.item.artist + " · " + root.item.meta; color: #85858a; font-size: 11px; overflow: elide; }
        }
        Text { text: root.item.duration; color: #77777c; font-size: 11px; vertical-alignment: center; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component PlaylistCard inherits Rectangle {
    in property <PlaylistItem> item;
    callback clicked();
    height: 54px;
    border-radius: 12px;
    clip: true;
    background: tap.has-hover ? #202024 : #171719;
    animate background { duration: 160ms; }
    HorizontalLayout {
        padding: 7px;
        spacing: 10px;
        Rectangle {
            width: 40px; height: 40px; border-radius: 8px; background: root.item.tint;
            clip: true;
            Image {
                width: 100%; height: 100%;
                source: root.item.cover;
                image-fit: cover;
                transform-scale-x: tap.has-hover ? 106% : 100%;
                transform-scale-y: tap.has-hover ? 106% : 100%;
                animate transform-scale-x, transform-scale-y { duration: 180ms; }
            }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♫"; color: #ffffff88; font-size: 16px; horizontal-alignment: center; vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 2px; alignment: center;
            Text { text: root.item.title; color: #f1f1f2; font-size: 13px; overflow: elide; }
            Text { text: root.item.meta; color: #85858a; font-size: 10px; overflow: elide; }
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    in property <bool> logged-in;
    in property <string> account-name: "";
    in property <string> account-id: "";
    in property <string> data-dir: "";
    in property <string> quality: "exhigh";
    in property <string> log-level: "info";
    in property <string> page: "home";
    in property <string> status-text: "";
    in-out property <string> cookie-text: "";
    in-out property <bool> login-open;
    in property <image> qr-image;
    in property <[PlaylistItem]> playlists;
    in property <[TrackItem]> recent-tracks;
    in property <[PlaylistItem]> library-playlists;
    in property <[TrackItem]> library-tracks;
    in property <[TrackItem]> new-tracks;
    in property <[TrackItem]> daily-tracks;
    in property <[TrackItem]> detail-tracks;
    in property <[TrackItem]> search-tracks;
    in property <[PlaylistItem]> search-playlists;
    in property <string> detail-title: "";
    in property <string> detail-meta: "";
    in property <string> detail-description: "";
    in property <color> detail-cover-tint: #171719;
    in property <image> detail-cover-image;
    in-out property <string> search-text: "";
    in property <string> current-id: "";
    in property <string> current-title: "";
    in property <string> current-artist: "";
    in property <string> current-album: "";
    in property <string> current-quality: "";
    in property <string> position-text: "00:00";
    in property <string> duration-text: "00:00";
    in property <color> current-cover: #c92027;
    in property <image> current-cover-image;
    in property <image> current-backdrop;
    in property <bool> playing;
    in property <bool> loading;
    in-out property <float> progress;
    in property <float> duration;
    in-out property <float> volume: 0.7;
    in property <bool> player-open;
    in property <[LyricItem]> lyrics;
    in property <int> lyric-index;
    in-out property <bool> lyric-follow: true;
    in-out property <length> lyric-scroll-y;
    private property <length> lyric-view-height: 560px;
    private property <length> lyric-line-height: 42px;
    pure function lyric-y-for(index: int) -> length {
        return max(0px, min(
            index * root.lyric-line-height - (root.lyric-view-height - root.lyric-line-height) / 2,
            root.lyrics.length * root.lyric-line-height - root.lyric-view-height
        ));
    }
    out property <length> lyric-target-y: root.lyric-y-for(root.lyric-index);

    callback refresh-qr();
    callback import-cookie(string);
    callback close-login();
    callback logout();
    callback nav(string);
    callback search(string);
    callback open-playlist(string);
    callback play-track(string);
    callback play-detail(string);
    callback toggle-play();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    callback volume-released(float);
    callback seek-lyric(float);
    callback set-quality(string);
    callback set-log-level(string);
    callback open-log-folder();
    callback open-player();
    callback close-player();

    title: "Decro Slint";
    icon: @image-url("../assets/icon.png");
    width: 1180px;
    height: 780px;
    background: @linear-gradient(160deg, #0d0d10 0%, #070709 58%, #0c0a0b 100%);

    Rectangle {
        x: -180px; y: -220px;
        width: 720px; height: 720px;
        background: @radial-gradient(circle, #c9202714 0%, #c9202700 70%);
    }
    Rectangle {
        x: root.width - 540px;
        y: root.height - 640px;
        width: 720px; height: 720px;
        background: @radial-gradient(circle, #e3b56d0d 0%, #e3b56d00 70%);
    }

    if root.login-open && !root.logged-in : Rectangle {
        x: 0; y: 0; width: 100%; height: 100%;
        z: 100;
        background: #000000cc;
        TouchArea { }
        Rectangle {
            width: 390px; height: 600px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 24px;
            background: #171719;
            border-width: 1px;
            border-color: #2d2d31;
            VerticalLayout {
                padding: 24px;
                spacing: 12px;
                Text { text: "登录网易云音乐"; color: #fff; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
                Text { text: "打开网易云 App 扫码"; color: #8d8d93; font-size: 12px; horizontal-alignment: center; }
                Rectangle {
                    height: 260px;
                    border-radius: 14px;
                    background: #f5f5f5;
                    Image { width: 100%; height: 100%; source: root.qr-image; image-fit: contain; }
                }
                Text { text: root.status-text; color: #b9b9be; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "刷新二维码"; clicked => { root.refresh-qr(); } }
                    Button { text: "关闭"; clicked => { root.close-login(); } }
                }
                LineEdit {
                    text <=> root.cookie-text;
                    placeholder-text: "或粘贴网页版 MUSIC_U Cookie";
                    height: 38px;
                }
                Button {
                    text: "导入 Cookie";
                    clicked => { root.import-cookie(root.cookie-text); }
                }
            }
        }
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 54px;
            background: #111113e6;
            border-width: 1px;
            border-color: #ffffff12;
            drop-shadow-color: #00000066;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 4px;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 8px;
                Text { text: "DECRO"; color: #f1f1f2; font-size: 18px; font-weight: 800; vertical-alignment: center; }
                Text { text: "DESKTOP"; color: #77777d; font-size: 9px; vertical-alignment: center; }
                Rectangle { width: 22px; }
                NavButton { label: "主页"; active: root.page == "home" || root.page == "detail"; clicked => { root.nav("home"); } }
                NavButton { label: "资料库"; active: root.page == "library"; clicked => { root.nav("library"); } }
                NavButton { label: "搜索"; active: root.page == "search"; clicked => { root.nav("search"); } }
                NavButton { label: "设置"; active: root.page == "settings"; clicked => { root.nav("settings"); } }
                Rectangle { horizontal-stretch: 1; }
                LineEdit {
                    width: 250px;
                    height: 34px;
                    text <=> root.search-text;
                    placeholder-text: "搜索歌曲或歌单";
                    accepted => { root.search(root.search-text); }
                }
                Button { text: "搜索"; clicked => { root.search(root.search-text); } }
                if root.logged-in : Text { width: 110px; text: root.account-name; color: #b9b9be; font-size: 12px; vertical-alignment: center; overflow: elide; }
                if root.logged-in : Button { text: "退出"; clicked => { root.logout(); } }
                if !root.logged-in : Button { text: "登录"; clicked => { root.login-open = true; root.refresh-qr(); } }
            }
        }

        if root.page == "home" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 126px;
                spacing: 16px;
                if root.recent-tracks.length > 0 : Text { text: "最近播放"; color: #f1f1f2; font-size: 24px; font-weight: 700; }
                if root.recent-tracks.length > 0 : ListView {
                    min-height: 210px;
                    for track in root.recent-tracks : TrackRow {
                        item: track;
                        current: track.id == root.current-id;
                        clicked => { root.play-track(track.id); }
                    }
                }
                if root.playlists.length > 0 : Text { text: "推荐歌单"; color: #f1f1f2; font-size: 24px; font-weight: 700; }
                if root.playlists.length > 0 : ListView {
                    min-height: 190px;
                    for item in root.playlists : PlaylistCard {
                        item: item;
                        clicked => { root.open-playlist(item.id); }
                    }
                }
                if root.daily-tracks.length > 0 : Text { text: "每日推荐"; color: #f1f1f2; font-size: 24px; font-weight: 700; }
                if root.daily-tracks.length > 0 : ListView {
                    min-height: 210px;
                    for track in root.daily-tracks : TrackRow {
                        item: track;
                        current: track.id == root.current-id;
                        clicked => { root.play-track(track.id); }
                    }
                }
                if root.new-tracks.length > 0 : Text { text: "新歌速递"; color: #f1f1f2; font-size: 24px; font-weight: 700; }
                if root.new-tracks.length > 0 : ListView {
                    min-height: 190px;
                    for track in root.new-tracks : TrackRow {
                        item: track;
                        current: track.id == root.current-id;
                        clicked => { root.play-track(track.id); }
                    }
                }
            }
        }

        if root.page == "library" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 126px;
                spacing: 14px;
                Text { text: "资料库"; color: #f1f1f2; font-size: 28px; font-weight: 700; }
                Text { text: "我的歌单"; color: #f1f1f2; font-size: 22px; font-weight: 650; }
                ListView {
                    min-height: 260px;
                    for item in root.library-playlists : PlaylistCard {
                        item: item;
                        clicked => { root.open-playlist(item.id); }
                    }
                }
                Text { text: "最近播放"; color: #f1f1f2; font-size: 22px; font-weight: 650; }
                ListView {
                    min-height: 260px;
                    for track in root.library-tracks : TrackRow {
                        item: track;
                        current: track.id == root.current-id;
                        clicked => { root.play-track(track.id); }
                    }
                }
            }
        }

        if root.page == "search" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 126px;
                spacing: 14px;
                Text { text: "搜索结果"; color: #f1f1f2; font-size: 28px; font-weight: 700; }
                Text { text: "歌曲"; color: #f1f1f2; font-size: 20px; font-weight: 650; }
                ListView {
                    min-height: 240px;
                    for track in root.search-tracks : TrackRow {
                        item: track;
                        current: track.id == root.current-id;
                        clicked => { root.play-track(track.id); }
                    }
                }
                Text { text: "歌单"; color: #f1f1f2; font-size: 20px; font-weight: 650; }
                ListView {
                    min-height: 200px;
                    for item in root.search-playlists : PlaylistCard {
                        item: item;
                        clicked => { root.open-playlist(item.id); }
                    }
                }
            }
        }

        if root.page == "detail" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 126px;
                spacing: 14px;
                Button { text: "← 返回"; clicked => { root.nav("home"); } }
                HorizontalLayout {
                    spacing: 16px;
                    Rectangle {
                        width: 104px; height: 104px;
                        border-radius: 14px;
                        background: root.detail-cover-tint;
                        clip: true;
                        Image { width: 100%; height: 100%; source: root.detail-cover-image; image-fit: cover; }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        alignment: center;
                        Text { text: root.detail-title; color: #f1f1f2; font-size: 24px; font-weight: 700; overflow: elide; }
                        Text { text: root.detail-meta; color: #8d8d93; font-size: 12px; overflow: elide; }
                        Text { text: root.detail-description; color: #85858a; font-size: 11px; wrap: word-wrap; max-height: 34px; overflow: elide; }
                    }
                }
                ListView {
                    min-height: 420px;
                    for track in root.detail-tracks : TrackRow {
                        item: track;
                        current: track.id == root.current-id;
                        clicked => { root.play-detail(track.id); }
                    }
                }
            }
        }

        if root.page == "settings" : ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                padding: 22px; padding-bottom: 126px;
                spacing: 16px;
                Text { text: "设置"; color: #f1f1f2; font-size: 28px; font-weight: 700; }

                Text { text: "账号"; color: #9a9a9f; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 64px;
                    border-radius: 12px;
                    background: #171719;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: root.logged-in ? root.account-name : "未登录"; color: #f1f1f2; font-size: 14px; overflow: elide; }
                            Text { text: root.logged-in ? "UID " + root.account-id : "扫码或导入 Cookie"; color: #85858a; font-size: 11px; overflow: elide; }
                        }
                        if root.logged-in : Button { text: "退出登录"; clicked => { root.logout(); } }
                    }
                }

                Text { text: "播放音质（下一首生效）"; color: #9a9a9f; font-size: 13px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    Chip { label: "标准"; active: root.quality == "standard"; clicked => { root.set-quality("standard"); } }
                    Chip { label: "较高"; active: root.quality == "higher"; clicked => { root.set-quality("higher"); } }
                    Chip { label: "极高"; active: root.quality == "exhigh"; clicked => { root.set-quality("exhigh"); } }
                    Chip { label: "无损"; active: root.quality == "lossless"; clicked => { root.set-quality("lossless"); } }
                    Chip { label: "Hi-Res"; active: root.quality == "hires"; clicked => { root.set-quality("hires"); } }
                }

                Text { text: "日志级别"; color: #9a9a9f; font-size: 13px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 8px;
                    Chip { label: "Debug"; active: root.log-level == "debug"; clicked => { root.set-log-level("debug"); } }
                    Chip { label: "Info"; active: root.log-level == "info"; clicked => { root.set-log-level("info"); } }
                    Chip { label: "Warn"; active: root.log-level == "warn"; clicked => { root.set-log-level("warn"); } }
                    Chip { label: "Error"; active: root.log-level == "error"; clicked => { root.set-log-level("error"); } }
                    Chip { label: "关闭"; active: root.log-level == "none"; clicked => { root.set-log-level("none"); } }
                }

                Text { text: "数据与日志"; color: #9a9a9f; font-size: 13px; font-weight: 600; }
                Rectangle {
                    height: 64px;
                    border-radius: 12px;
                    background: #171719;
                    HorizontalLayout {
                        padding-left: 16px; padding-right: 16px;
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text { text: "数据目录"; color: #85858a; font-size: 11px; }
                            Text { text: root.data-dir; color: #b9b9be; font-size: 12px; overflow: elide; }
                        }
                        Button { text: "打开日志目录"; clicked => { root.open-log-folder(); } }
                    }
                }

                Text { text: "Decro Slint 0.1.3 · 原生 UI · 软件渲染 · 便携数据"; color: #6f6f75; font-size: 11px; }
            }
        }

    }

    // Floating status toast, above the dock.
    if root.status-text != "" && !root.player-open : Rectangle {
        x: 18px;
        y: root.height - 136px;
        width: min(root.width - 36px, 560px);
        height: 26px;
        z: 29;
        border-radius: 13px;
        background: #101012e6;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 12px;
        drop-shadow-offset-y: 4px;
        Text {
            x: 12px; y: 0;
            width: parent.width - 24px;
            height: parent.height;
            text: root.status-text;
            color: #a8a8ae;
            font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // Floating dock. The cover and metadata open the now-playing page.
    Rectangle {
        visible: !root.player-open;
        x: 18px;
        y: root.height - 100px;
        width: root.width - 36px;
        height: 82px;
        z: 30;
        border-radius: 24px;
        background: @linear-gradient(180deg, #1e1e22ee 0%, #141417ee 100%);
        border-width: 1px;
        border-color: #ffffff1c;
        drop-shadow-color: #000000b3;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        TouchArea { }

        Rectangle {
            x: (parent.width - 36px) / 2;
            y: 4px;
            width: 36px;
            height: 2px;
            border-radius: 1px;
            background: #ffffff2e;
        }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 14px;
            spacing: 12px;
            alignment: center;

            Rectangle {
                width: 60px;
                height: 60px;
                border-radius: 16px;
                background: root.current-cover;
                clip: true;
                drop-shadow-color: #00000066;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: 4px;
                Image {
                    width: 100%; height: 100%;
                    source: root.current-cover-image;
                    image-fit: cover;
                    transform-scale-x: cover-tap.has-hover ? 104% : 100%;
                    transform-scale-y: cover-tap.has-hover ? 104% : 100%;
                    animate transform-scale-x, transform-scale-y { duration: 180ms; }
                }
                if root.current-cover-image.width == 0 : Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    text: "♪";
                    color: #ffffff88;
                    font-size: 22px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    visible: cover-tap.has-hover;
                    x: 0; y: 0;
                    width: 100%; height: 100%;
                    background: #00000066;
                    Text {
                        text: "↗";
                        color: #ffffff;
                        font-size: 20px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                cover-tap := TouchArea { clicked => { root.open-player(); } }
            }

            Rectangle {
                width: 190px;
                height: 60px;
                background: transparent;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text { text: root.current-title; color: #f1f1f2; font-size: 13px; font-weight: 600; overflow: elide; }
                    Text { text: root.current-artist; color: #8e8e93; font-size: 10px; overflow: elide; }
                }
                TouchArea { clicked => { root.open-player(); } }
            }

            DockIconButton { glyph: "⏮"; clicked => { root.prev(); } }
            DockIconButton {
                glyph: root.loading ? "…" : (root.playing ? "⏸" : "▶");
                primary: true;
                clicked => { root.toggle-play(); }
            }
            DockIconButton { glyph: "⏭"; clicked => { root.next(); } }

            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                alignment: center;
                HorizontalLayout {
                    Text { text: root.position-text; color: #8e8e93; font-size: 9px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.duration-text; color: #8e8e93; font-size: 9px; }
                }
                Slider {
                    minimum: 0; maximum: root.duration; value <=> root.progress;
                    changed(value) => { root.seek(value); }
                }
            }

            Rectangle {
                width: 68px;
                height: 22px;
                border-radius: 11px;
                background: #7aa9f01a;
                border-width: 1px;
                border-color: #7aa9f033;
                Text {
                    text: root.current-quality;
                    color: #9fc0f5;
                    font-size: 9px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Text { text: "音量"; color: #8e8e93; font-size: 9px; vertical-alignment: center; }
                Slider {
                    width: 86px; minimum: 0; maximum: 1; value <=> root.volume;
                    changed(value) => { root.volume-changed(value); }
                    released(value) => { root.volume-released(value); }
                }
            }

            DockPill { label: "歌词"; clicked => { root.open-player(); } }
        }
    }

    // Now playing / song details.
    if root.player-open : Rectangle {
        x: 0; y: 0;
        width: root.width;
        height: root.height;
        z: 40;
        background: #08090b;

        Image {
            x: -root.width * 0.1;
            y: -root.height * 0.1;
            width: root.width * 1.2;
            height: root.height * 1.2;
            source: root.current-backdrop;
            image-fit: cover;
            opacity: 0.85;
        }
        Rectangle {
            width: 100%; height: 100%;
            background: @linear-gradient(180deg, #08090bcc 0%, #08090be8 55%, #08090b 100%);
        }
        Rectangle {
            x: -160px;
            y: root.height - 520px;
            width: 700px;
            height: 700px;
            background: @radial-gradient(circle, #c9202744 0%, #c9202700 70%);
        }
        Rectangle {
            x: 40px;
            y: 140px;
            width: 320px;
            height: 320px;
            border-radius: 160px;
            background: root.current-cover;
            opacity: 0.16;
            drop-shadow-color: root.current-cover;
            drop-shadow-blur: 90px;
        }

        TouchArea { }

        VerticalLayout {
            padding: 26px;
            spacing: 14px;

            HorizontalLayout {
                spacing: 12px;
                alignment: center;
                DockIconButton { glyph: "⌄"; clicked => { root.close-player(); } }
                Text { text: "正在播放"; color: #ffffffb8; font-size: 11px; font-weight: 650; letter-spacing: 1px; vertical-alignment: center; }
                VerticalLayout {
                    alignment: center;
                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #ff645d; }
                }
                Text { text: "网易云音乐"; color: #ffffff40; font-size: 10px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.current-quality; color: #ffffff66; font-size: 10px; vertical-alignment: center; }
                DockPill { label: "收起"; width: 58px; clicked => { root.close-player(); } }
            }

            HorizontalLayout {
                spacing: 34px;
                vertical-stretch: 1;

                VerticalLayout {
                    width: 350px;
                    spacing: 14px;
                    alignment: center;

                    Rectangle {
                        width: 320px;
                        height: 320px;
                        border-radius: 24px;
                        background: root.current-cover;
                        clip: true;
                        drop-shadow-color: #000000b3;
                        drop-shadow-blur: 46px;
                        drop-shadow-offset-y: 20px;
                        Image { width: 100%; height: 100%; source: root.current-cover-image; image-fit: cover; }
                        if root.current-cover-image.width == 0 : Text {
                            x: 0; y: 0; width: 100%; height: 100%;
                            text: "♪";
                            color: #ffffff55;
                            font-size: 64px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: root.current-title;
                        color: #f7f7f8;
                        font-size: 24px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        max-height: 64px;
                        overflow: elide;
                    }
                    Text { text: root.current-artist; color: #c7c7cc; font-size: 14px; horizontal-alignment: center; overflow: elide; }
                    Text { text: root.current-album; color: #8e8e93; font-size: 11px; horizontal-alignment: center; overflow: elide; }

                    HorizontalLayout {
                        spacing: 18px;
                        alignment: center;
                        DockIconButton { glyph: "⏮"; width: 40px; height: 40px; clicked => { root.prev(); } }
                        DockIconButton {
                            glyph: root.loading ? "…" : (root.playing ? "⏸" : "▶");
                            primary: true;
                            width: 54px;
                            height: 54px;
                            clicked => { root.toggle-play(); }
                        }
                        DockIconButton { glyph: "⏭"; width: 40px; height: 40px; clicked => { root.next(); } }
                    }

                    VerticalLayout {
                        width: 100%;
                        spacing: 3px;
                        HorizontalLayout {
                            Text { text: root.position-text; color: #8e8e93; font-size: 9px; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.duration-text; color: #8e8e93; font-size: 9px; }
                        }
                        Slider {
                            minimum: 0; maximum: root.duration; value <=> root.progress;
                            changed(value) => { root.seek(value); }
                        }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 10px;
                        Text { text: "歌词"; color: #f1f1f2; font-size: 18px; font-weight: 700; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text {
                            text: root.lyric-follow ? "滚轮或拖动查看，点击歌词跳转" : "已暂停自动跟随";
                            color: #8e8e93;
                            font-size: 10px;
                            vertical-alignment: center;
                        }
                        if !root.lyric-follow : DockPill {
                            label: "回到当前";
                            width: 86px;
                            clicked => {
                                root.lyric-follow = true;
                                root.lyric-scroll-y = root.lyric-target-y;
                            }
                        }
                    }

                    Flickable {
                        height: root.lyric-view-height;
                        content-width: self.width;
                        content-height: root.lyrics.length * root.lyric-line-height;
                        content-y <=> root.lyric-scroll-y;
                        flicked => { root.lyric-follow = false; }
                        for line[index] in root.lyrics : Rectangle {
                            y: index * root.lyric-line-height;
                            width: parent.width;
                            height: root.lyric-line-height;
                            background: line-tap.has-hover ? #ffffff09 : transparent;
                            animate background { duration: 120ms; }
                            Rectangle {
                                x: 0;
                                y: (root.lyric-line-height - 18px) / 2;
                                width: 3px;
                                height: 18px;
                                border-radius: 2px;
                                background: #ff645d;
                                visible: index == root.lyric-index;
                            }
                            Text {
                                x: 14px;
                                width: parent.width - 28px;
                                height: parent.height;
                                text: line.text;
                                color: index == root.lyric-index ? #ffffff : #77777d;
                                font-size: index == root.lyric-index ? 21px : 14px;
                                font-weight: index == root.lyric-index ? 700 : 400;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                overflow: elide;
                                animate color { duration: 160ms; }
                                animate font-size { duration: 160ms; }
                            }
                            line-tap := TouchArea {
                                clicked => {
                                    root.lyric-follow = true;
                                    root.lyric-scroll-y = root.lyric-y-for(index);
                                    root.seek-lyric(line.time);
                                }
                            }
                        }
                    }
                }
            }
        }
    }

}
