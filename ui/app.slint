import { ScrollView, Palette } from "std-widgets.slint";

export struct TrackItem {
    id: string,
    title: string,
    artist: string,
    meta: string,
    duration: string,
    quality: string,
    cover: image,
    tint: color,
}

export struct PlaylistItem {
    id: string,
    title: string,
    meta: string,
    cover: image,
    tint: color,
}

export struct LyricItem {
    time: float,
    text: string,
    translation: string,
}

// ── Small building blocks ────────────────────────────────────────────────

component Glyph inherits Image {
    in property <length> glyph-size: 18px;
    in property <color> tint: #8e8e93;
    width: root.glyph-size;
    height: root.glyph-size;
    colorize: root.tint;
    image-fit: contain;
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 17px;
    in property <color> tint: #8e8e93;
    in property <color> hover-tint: #f5f5f7;
    in property <color> hover-background: #ffffff0d;
    in property <bool> danger;
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: tap.has-hover ? (root.danger ? #d13438 : root.hover-background) : transparent;
    animate background { duration: 120ms; }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: root.icon-size;
        tint: tap.has-hover ? (root.danger ? #ffffff : root.hover-tint) : root.tint;
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component NavIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    callback clicked();
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: root.active ? #c920271f : (tap.has-hover ? #ffffff0a : transparent);
    animate background { duration: 140ms; }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: 20px;
        tint: root.active ? #ff645d : (tap.has-hover ? #f5f5f7 : #8e8e93);
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    in property <bool> disabled;
    callback clicked();
    height: 32px;
    width: 96px;
    border-radius: 16px;
    background: root.primary ? (tap.has-hover ? #ff7d76 : #ff645d) : (tap.has-hover ? #ffffff16 : #ffffff0a);
    border-width: root.primary ? 0px : 1px;
    border-color: #ffffff14;
    opacity: root.disabled ? 0.4 : 1;
    animate background { duration: 140ms; }
    label-text := Text {
        text: root.label;
        color: root.primary ? #1b0b0e : #dedee3;
        font-size: 12px;
        horizontal-alignment: center;
        vertical-alignment: center;
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
    }
    tap := TouchArea {
        clicked => {
            if !root.disabled {
                root.clicked();
            }
        }
    }
}

component Switch inherits Rectangle {
    in property <bool> checked;
    callback toggled(bool);
    width: 46px;
    height: 26px;
    border-radius: 13px;
    background: root.checked ? #ff645d : #48484f;
    animate background { duration: 150ms; }
    Rectangle {
        x: root.checked ? root.width - 23px : 3px;
        y: 3px;
        width: 20px;
        height: 20px;
        border-radius: 10px;
        background: #ffffff;
        animate x { duration: 160ms; easing: ease-out; }
    }
    TouchArea { clicked => { root.toggled(!root.checked); } }
}

component SettingsToggleRow inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> checked;
    callback toggled(bool);
    height: 74px;
    border-radius: 16px;
    background: #242528;
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        cross-axis-alignment: center;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.title; color: #f5f5f7; font-size: 14px; font-weight: 600; overflow: elide; }
            Text { text: root.description; color: #8e8e93; font-size: 11px; overflow: elide; }
        }
        Switch {
            checked: root.checked;
            toggled(value) => { root.toggled(value); }
        }
    }
}

component RoundIconButton inherits Rectangle {
    in property <image> icon;
    in property <length> icon-size: 20px;
    in property <length> button-size: 62px;
    in property <color> background-color: #ffffff21;
    in property <color> tint: #ffffff;
    callback clicked();
    width: root.button-size;
    height: root.button-size;
    border-radius: self.width / 2;
    background: tap.has-hover ? #ffffff30 : root.background-color;
    transform-scale-x: tap.pressed ? 92% : (tap.has-hover ? 105% : 100%);
    transform-scale-y: tap.pressed ? 92% : (tap.has-hover ? 105% : 100%);
    animate background { duration: 140ms; }
    animate transform-scale-x, transform-scale-y { duration: 120ms; easing: ease-out; }
    Glyph {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        glyph-size: root.icon-size;
        tint: root.tint;
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

// ── Content components ───────────────────────────────────────────────────

component FeatureCard inherits Rectangle {
    in property <PlaylistItem> item;
    in property <string> eyebrow;
    callback clicked();
    border-radius: 26px;
    clip: true;
    background: root.item.tint;
    Image {
        width: 100%;
        height: 100%;
        source: root.item.cover;
        image-fit: cover;
        transform-scale-x: tap.has-hover ? 103% : 100%;
        transform-scale-y: tap.has-hover ? 103% : 100%;
        animate transform-scale-x, transform-scale-y { duration: 420ms; easing: ease-out; }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(180deg, #00000000 20%, #0000001a 50%, #000000d9 100%);
    }
    VerticalLayout {
        alignment: end;
        padding: 28px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 7px;
            cross-axis-alignment: center;
            Glyph {
                source: @image-url("../assets/icons/sparkles.svg");
                glyph-size: 13px;
                tint: #ffffffb3;
            }
            Text {
                text: root.eyebrow;
                color: #ffffffb3;
                font-size: 10px;
                font-weight: 650;
                letter-spacing: 1px;
            }
        }
        Text {
            text: root.item.title;
            color: #ffffff;
            font-size: 34px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.item.meta;
            color: #ffffffab;
            font-size: 12px;
            overflow: elide;
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component ShelfCard inherits Rectangle {
    in property <PlaylistItem> item;
    callback clicked();
    width: 176px;
    height: 222px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: 176px;
            height: 176px;
            border-radius: 18px;
            background: root.item.tint;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
                transform-scale-x: tap.has-hover ? 104% : 100%;
                transform-scale-y: tap.has-hover ? 104% : 100%;
                animate transform-scale-x, transform-scale-y { duration: 360ms; easing: ease-out; }
            }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♫";
                color: #ffffff77;
                font-size: 42px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.title;
            color: #f5f5f7;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.meta;
            color: #8e8e93;
            font-size: 10px;
            overflow: elide;
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component TrackShelfCard inherits Rectangle {
    in property <TrackItem> item;
    callback clicked();
    width: 176px;
    height: 222px;
    background: transparent;
    VerticalLayout {
        spacing: 8px;
        Rectangle {
            width: 176px;
            height: 176px;
            border-radius: 18px;
            background: root.item.tint;
            clip: true;
            Image {
                width: 100%;
                height: 100%;
                source: root.item.cover;
                image-fit: cover;
                transform-scale-x: tap.has-hover ? 104% : 100%;
                transform-scale-y: tap.has-hover ? 104% : 100%;
                animate transform-scale-x, transform-scale-y { duration: 360ms; easing: ease-out; }
            }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff77;
                font-size: 42px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.title;
            color: #f5f5f7;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            text: root.item.artist;
            color: #8e8e93;
            font-size: 10px;
            overflow: elide;
        }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component MediaRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> current;
    callback clicked();
    height: 72px;
    border-radius: 16px;
    clip: true;
    background: root.current ? #2a1719 : (tap.has-hover ? #232326 : #17171a);
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: root.item.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.cover; image-fit: cover; }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff77;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text { text: root.item.title; color: #f5f5f7; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.item.artist + " · " + root.item.meta; color: #8e8e93; font-size: 12px; overflow: elide; }
        }
        if root.current : Rectangle {
            width: 7px; height: 7px; border-radius: 4px; background: #ff645d;
        }
        Text { text: root.item.duration; color: #77777d; font-size: 11px; vertical-alignment: center; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component PlaylistRow inherits Rectangle {
    in property <PlaylistItem> item;
    in property <bool> circle;
    callback clicked();
    height: 72px;
    border-radius: 16px;
    clip: true;
    background: tap.has-hover ? #232326 : #17171a;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        Rectangle {
            width: 52px;
            height: 52px;
            border-radius: root.circle ? 26px : 12px;
            background: root.item.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.cover; image-fit: cover; }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: root.circle ? "♬" : "♫";
                color: #ffffff77;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text { text: root.item.title; color: #f5f5f7; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.item.meta; color: #8e8e93; font-size: 12px; overflow: elide; }
        }
        Glyph { source: @image-url("../assets/icons/chevron-right.svg"); glyph-size: 15px; tint: #5f5f66; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component DetailRow inherits Rectangle {
    in property <TrackItem> item;
    in property <bool> current;
    callback clicked();
    height: 76px;
    border-radius: 16px;
    clip: true;
    background: root.current ? #c9202726 : (tap.has-hover ? #ffffff12 : #ffffff08);
    border-width: 1px;
    border-color: root.current ? #c9202755 : transparent;
    animate background { duration: 150ms; }
    HorizontalLayout {
        padding: 10px;
        spacing: 14px;
        Rectangle {
            width: 54px;
            height: 54px;
            border-radius: 13px;
            background: root.item.tint;
            clip: true;
            Image { width: 100%; height: 100%; source: root.item.cover; image-fit: cover; }
            if root.item.cover.width == 0 : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: "♪";
                color: #ffffff77;
                font-size: 20px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 4px;
            alignment: center;
            Text { text: root.item.title; color: #f5f5f7; font-size: 15px; font-weight: 600; overflow: elide; }
            Text { text: root.item.artist; color: #8e8e93; font-size: 12px; overflow: elide; }
        }
        if root.current : Rectangle {
            width: 8px; height: 8px; border-radius: 4px; background: #ff645d;
        }
        Text { text: root.item.duration; color: #8e8e93; font-size: 11px; vertical-alignment: center; }
    }
    tap := TouchArea { clicked => { root.clicked(); } }
}

component SearchField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder: "搜索歌曲、歌手、歌单";
    callback accepted();
    height: 64px;
    border-radius: 32px;
    background: #1b1c1e;
    border-width: 1px;
    border-color: #ffffff12;
    HorizontalLayout {
        padding-left: 22px;
        padding-right: 14px;
        spacing: 12px;
        cross-axis-alignment: center;
        Glyph { source: @image-url("../assets/icons/search.svg"); glyph-size: 20px; tint: #8e8e93; }
        Rectangle {
            horizontal-stretch: 1;
            height: 34px;
            background: transparent;
            TouchArea { clicked => { input.focus(); } }
            if root.text.is-empty : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: root.placeholder;
                color: #77777d;
                font-size: 16px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 0; y: 0; width: 100%; height: 100%;
                text <=> root.text;
                color: #f5f5f7;
                font-size: 16px;
                vertical-alignment: center;
                accepted => { root.accepted(); }
            }
        }
        if !root.text.is-empty : IconButton {
            icon: @image-url("../assets/icons/close.svg");
            icon-size: 14px;
            width: 28px;
            height: 28px;
            clicked => { root.text = ""; }
        }
        PillButton {
            label: "搜索";
            width: 68px;
            primary: true;
            clicked => { root.accepted(); }
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> autofocus;
    callback accepted();
    init => { if root.autofocus { input.focus(); } }
    height: 40px;
    border-radius: 10px;
    background: #101012;
    border-width: 1px;
    border-color: #ffffff12;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Rectangle {
            horizontal-stretch: 1;
            background: transparent;
            TouchArea { clicked => { input.focus(); } }
            if root.text.is-empty : Text {
                x: 0; y: 0; width: 100%; height: 100%;
                text: root.placeholder;
                color: #77777d;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
            }
            input := TextInput {
                x: 0; y: 0; width: 100%; height: 100%;
                text <=> root.text;
                color: #f5f5f7;
                font-size: 12px;
                vertical-alignment: center;
                accepted => { root.accepted(); }
            }
        }
    }
}

component SeekBar inherits Rectangle {
    in property <float> value;
    in property <float> maximum;
    callback seek(float);
    height: 26px;
    property <length> fill-width: root.maximum > 0
        ? min(root.width, root.width * max(0, min(1, root.value / root.maximum)))
        : 0px;
    Rectangle {
        x: 0;
        y: (parent.height - 3px) / 2;
        width: 100%;
        height: 3px;
        border-radius: 2px;
        background: #ffffff3d;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 3px) / 2;
        width: root.fill-width;
        height: 3px;
        border-radius: 2px;
        background: #ffffff;
    }
    Rectangle {
        x: root.fill-width - 2px;
        y: (parent.height - 18px) / 2;
        width: 4px;
        height: 18px;
        border-radius: 2px;
        background: #ffffff;
        visible: root.maximum > 0;
    }
    tap := TouchArea {
        clicked => {
            root.seek(root.maximum * max(0, min(1, tap.mouse-x / self.width)));
        }
        moved => {
            if (tap.pressed) {
                root.seek(root.maximum * max(0, min(1, tap.mouse-x / self.width)));
            }
        }
    }
}

component VolumeBar inherits Rectangle {
    in-out property <float> value;
    callback changed(float);
    callback released();
    height: 22px;
    width: 110px;
    property <length> fill-width: root.width * max(0, min(1, root.value));
    Rectangle {
        x: 0;
        y: (parent.height - 2px) / 2;
        width: 100%;
        height: 2px;
        border-radius: 1px;
        background: #ffffff38;
    }
    Rectangle {
        x: 0;
        y: (parent.height - 2px) / 2;
        width: root.fill-width;
        height: 2px;
        border-radius: 1px;
        background: #ffffffb8;
    }
    tap := TouchArea {
        clicked => {
            root.value = max(0, min(1, tap.mouse-x / self.width));
            root.changed(root.value);
        }
        moved => {
            if (tap.pressed) {
                root.value = max(0, min(1, tap.mouse-x / self.width));
                root.changed(root.value);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.up) {
                root.released();
            }
        }
    }
}

// ── Window ───────────────────────────────────────────────────────────────

export component AppWindow inherits Window {
    no-frame: true;
    resize-border-width: 6px;
    title: "Decro";
    icon: @image-url("../assets/icon.png");
    width: 1200px;
    height: 760px;
    background: #000000;
    default-font-family: "Segoe UI";
    init => { Palette.color-scheme = ColorScheme.dark; }

    private property <length> titlebar-height: 48px;
    private property <length> dock-height: 82px;
    private property <length> sidebar-width: 76px;
    private property <length> lyric-line-height: 64px;
    private property <length> lyric-view-height: 430px;

    // Account / session
    in property <bool> logged-in;
    in property <string> account-name: "";
    in property <string> account-id: "";
    in property <string> account-initial: "D";
    in-out property <bool> login-open;
    in property <image> qr-image;
    in-out property <string> cookie-text: "";

    // Pages
    in property <string> page: "home";
    in property <string> status-text: "";
    in property <string> data-dir: "";
    in property <string> quality: "exhigh";
    in property <string> log-level: "info";
    in property <bool> low-power;
    in property <bool> show-translation: true;
    in property <bool> cover-accent: true;

    // Models
    in property <[PlaylistItem]> playlists;
    in property <PlaylistItem> daily-feature;
    in property <PlaylistItem> feature-playlist;
    in property <[TrackItem]> recent-tracks;
    in property <[TrackItem]> daily-tracks;
    in property <[TrackItem]> new-tracks;
    in property <[PlaylistItem]> library-playlists;
    in property <[TrackItem]> library-tracks;
    in property <[TrackItem]> detail-tracks;
    in property <string> detail-title: "";
    in property <string> detail-meta: "";
    in property <string> detail-description: "";
    in property <string> detail-first-id: "";
    in property <color> detail-cover-tint: #17171a;
    in property <image> detail-cover-image;
    in property <image> detail-backdrop;
    in property <[PlaylistItem]> detail-albums;
    in property <bool> detail-subscribed;
    in property <string> detail-kind: "";
    in property <string> detail-id: "";
    in property <string> detail-origin: "home";
    in property <[TrackItem]> search-tracks;
    in property <[PlaylistItem]> search-playlists;
    in property <[PlaylistItem]> search-artists;
    in property <[PlaylistItem]> search-albums;
    in-out property <string> search-kind: "song";
    in-out property <string> search-text: "";
    in-out property <bool> playlist-dialog-open;
    in-out property <string> playlist-dialog-mode: "create";
    in-out property <string> playlist-dialog-text: "";

    // Player
    in property <string> current-id: "";
    in property <string> current-title: "";
    in property <string> current-artist: "";
    in property <string> current-album: "";
    in property <string> current-quality: "";
    in property <color> current-cover: #c92027;
    in property <image> current-cover-image;
    in property <image> current-backdrop;
    in property <string> position-text: "00:00";
    in property <string> duration-text: "00:00";
    in property <bool> playing;
    in property <bool> loading;
    in property <bool> current-liked;
    in-out property <float> progress;
    in property <float> duration;
    in-out property <float> volume: 0.64;
    in-out property <bool> player-open;
    in-out property <bool> player-visible;
    in-out property <bool> cover-flying;
    in property <[TrackItem]> queue-tracks;
    in property <int> queue-index;
    in-out property <bool> queue-open;
    private property <length> player-cover-size: 360px;
    private property <length> player-cover-fly-x: 68px + ((root.width - 136px) * 0.4 - root.player-cover-size) / 2;
    private property <length> player-cover-fly-y: root.titlebar-height + 60px + (root.height - root.titlebar-height - 196px - root.player-cover-size) / 2;
    in-out property <bool> lyrics-mode;
    in property <[LyricItem]> lyrics;
    in property <int> lyric-index;
    in-out property <bool> lyric-follow: true;
    in-out property <length> lyric-scroll-y;
    out property <length> lyric-target-y: root.lyric-y-for(root.lyric-index);

    pure function lyric-y-for(index: int) -> length {
        return max(0px, min(
            index * root.lyric-line-height - (root.lyric-view-height - root.lyric-line-height) / 2,
            root.lyrics.length * root.lyric-line-height - root.lyric-view-height
        ));
    }

    callback refresh-qr();
    callback import-cookie(string);
    callback close-login();
    callback logout();
    callback nav(string);
    callback search(string);
    callback open-playlist(string);
    callback open-daily();
    callback open-artist(string);
    callback open-album(string);
    callback back-detail();
    callback toggle-subscribe();
    callback open-playlist-dialog(string);
    callback close-playlist-dialog();
    callback submit-playlist-dialog(string);
    callback play-track(string);
    callback play-detail(string);
    callback toggle-play();
    callback toggle-like();
    callback next();
    callback prev();
    callback seek(float);
    callback volume-changed(float);
    callback volume-released(float);
    callback seek-lyric(float);
    callback set-quality(string);
    callback set-log-level(string);
    callback set-low-power(bool);
    callback set-cover-accent(bool);
    callback set-show-translation(bool);
    callback open-log-folder();
    callback open-player();
    callback close-player();
    callback toggle-queue();
    callback play-queue(int);

    // Page transition is expressed with a soft opacity fade.
    in-out property <float> page-opacity: 1;

    // Ambient wash behind the app shell.
    Rectangle {
        x: -220px;
        y: -260px;
        width: 920px;
        height: 920px;
        background: @radial-gradient(circle, #c9202716 0%, #c9202700 64%);
    }
    Rectangle {
        x: root.width - 760px;
        y: root.height - 760px;
        width: 900px;
        height: 900px;
        background: @radial-gradient(circle, #6b3fa012 0%, #6b3fa000 64%);
    }

    VerticalLayout {
        spacing: 0px;

        // ── Custom titlebar ─────────────────────────────────────────────
        Rectangle {
            height: root.titlebar-height;
            background: #09090b;
            border-width: 1px;
            border-color: #ffffff0f;
            z: 20;
            WindowMoveArea { }

            HorizontalLayout {
                padding-left: 18px;
                padding-right: 10px;
                spacing: 14px;
                cross-axis-alignment: center;

                HorizontalLayout {
                    width: 184px;
                    spacing: 9px;
                    cross-axis-alignment: center;
                    Image {
                        width: 27px;
                        height: 27px;
                        source: @image-url("../assets/icon.png");
                        image-fit: contain;
                    }
                    Text { text: "Decro"; color: #f5f5f7; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                    Text { text: "DESKTOP"; color: #8e8e93; font-size: 8px; font-weight: 650; letter-spacing: 1.4px; vertical-alignment: center; }
                }

                IconButton {
                    icon: @image-url("../assets/icons/chevron-left.svg");
                    icon-size: 16px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.nav("home"); }
                }
                IconButton {
                    icon: @image-url("../assets/icons/chevron-right.svg");
                    icon-size: 16px;
                    width: 28px;
                    height: 28px;
                    tint: #4f4f55;
                    clicked => { }
                }

                Rectangle {
                    width: 400px;
                    height: 30px;
                    border-radius: 9px;
                    background: search-trigger-tap.has-hover ? #ffffff12 : #ffffff09;
                    border-width: 1px;
                    border-color: #ffffff12;
                    animate background { duration: 140ms; }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 8px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Glyph { source: @image-url("../assets/icons/search.svg"); glyph-size: 15px; tint: #8e8e93; }
                        Text { horizontal-stretch: 1; text: "搜索歌曲、歌单或命令"; color: #8e8e93; font-size: 11px; vertical-alignment: center; overflow: elide; }
                        Rectangle {
                            height: 18px;
                            width: 38px;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #ffffff12;
                            background: #ffffff08;
                            Text { text: "Ctrl K"; color: #8e8e93; font-size: 9px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    search-trigger-tap := TouchArea { clicked => { root.nav("search"); } }
                }

                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    height: 30px;
                    width: 120px;
                    border-radius: 15px;
                    background: account-tap.has-hover ? #ffffff0d : transparent;
                    HorizontalLayout {
                        padding-left: 3px;
                        padding-right: 7px;
                        spacing: 7px;
                        cross-axis-alignment: center;
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            background: @linear-gradient(135deg, #7e838d, #3c4149);
                            Text { text: root.account-initial; color: #ffffff; font-size: 10px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { horizontal-stretch: 1; text: root.logged-in ? root.account-name : "登录"; color: #c7c7cc; font-size: 11px; vertical-alignment: center; overflow: elide; }
                    }
                    account-tap := TouchArea {
                        clicked => {
                            if root.logged-in {
                                root.nav("settings");
                            } else {
                                root.login-open = true;
                                root.refresh-qr();
                            }
                        }
                    }
                }

                IconButton {
                    icon: @image-url("../assets/icons/grid.svg");
                    icon-size: 17px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.nav("explore"); }
                }
                IconButton {
                    icon: @image-url("../assets/icons/settings.svg");
                    icon-size: 17px;
                    width: 28px;
                    height: 28px;
                    clicked => { root.nav("settings"); }
                }

                Rectangle {
                    height: 26px;
                    width: 1px;
                    background: #ffffff14;
                }

                IconButton {
                    icon: @image-url("../assets/icons/minimize.svg");
                    icon-size: 13px;
                    width: 34px;
                    height: 30px;
                    clicked => { root.minimized = true; }
                }
                IconButton {
                    icon: @image-url("../assets/icons/maximize.svg");
                    icon-size: 12px;
                    width: 34px;
                    height: 30px;
                    clicked => { root.maximized = !root.maximized; }
                }
                IconButton {
                    icon: @image-url("../assets/icons/close.svg");
                    icon-size: 13px;
                    width: 34px;
                    height: 30px;
                    danger: true;
                    clicked => { root.close(); }
                }
            }
        }

        // ── Workspace ───────────────────────────────────────────────────
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            Rectangle {
                width: root.sidebar-width;
                background: #08080a;
                border-width: 1px;
                border-color: #ffffff0d;
                VerticalLayout {
                    padding-top: 16px;
                    padding-bottom: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 3px;
                    cross-axis-alignment: center;
                    NavIcon {
                        icon: @image-url("../assets/icons/home.svg");
                        active: root.page == "home" || root.page == "detail";
                        clicked => { root.nav("home"); }
                    }
                    NavIcon {
                        icon: @image-url("../assets/icons/grid.svg");
                        active: root.page == "explore";
                        clicked => { root.nav("explore"); }
                    }
                    NavIcon {
                        icon: @image-url("../assets/icons/library.svg");
                        active: root.page == "library";
                        clicked => { root.nav("library"); }
                    }
                    NavIcon {
                        icon: @image-url("../assets/icons/search.svg");
                        active: root.page == "search";
                        clicked => { root.nav("search"); }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Rectangle {
                        width: 40px;
                        height: 40px;
                        border-radius: 20px;
                        background: @linear-gradient(135deg, #7e838d, #3c4149);
                        Text { text: root.account-initial; color: #ffffff; font-size: 12px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                        sidebar-avatar-tap := TouchArea {
                            clicked => {
                                if root.logged-in {
                                    root.nav("settings");
                                } else {
                                    root.login-open = true;
                                    root.refresh-qr();
                                }
                            }
                        }
                    }
                }
            }

            // ── Page area ─────────────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;
                opacity: root.page-opacity;
                animate opacity { duration: 180ms; easing: ease-out; }

                if root.page == "home" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 24px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            VerticalLayout {
                                spacing: 4px;
                                Text { text: "主页"; color: #f5f5f7; font-size: 34px; font-weight: 700; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                home-avatar-tap := TouchArea { clicked => { if root.logged-in { root.nav("settings"); } else { root.login-open = true; root.refresh-qr(); } } }
                            }
                        }

                        HorizontalLayout {
                            spacing: 20px;
                            FeatureCard {
                                horizontal-stretch: 1;
                                height: 460px;
                                item: root.daily-feature;
                                eyebrow: "今日更新";
                                clicked => { root.open-daily(); }
                            }
                            FeatureCard {
                                horizontal-stretch: 1;
                                height: 460px;
                                item: root.feature-playlist;
                                eyebrow: "为你推荐";
                                clicked => {
                                    if root.feature-playlist.id != "" {
                                        root.open-playlist(root.feature-playlist.id);
                                    }
                                }
                            }
                        }

                        if root.playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "推荐歌单"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.playlists.length * 192px;
                                content-height: self.height;
                                for item[index] in root.playlists : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.new-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "新歌速递"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.new-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.new-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }

                        if root.recent-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Text { text: "最近播放"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                                Rectangle { horizontal-stretch: 1; }
                                PillButton { label: "查看全部"; width: 80px; clicked => { root.nav("recent"); } }
                            }
                            Flickable {
                                height: 236px;
                                content-width: root.recent-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.recent-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }
                    }
                }

                if root.page == "explore" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 24px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            Text { text: "推荐"; color: #f5f5f7; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        if root.recent-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            HorizontalLayout {
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Text { text: "最近播放"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                                Rectangle { horizontal-stretch: 1; }
                                PillButton { label: "查看全部"; width: 80px; clicked => { root.nav("recent"); } }
                            }
                            Flickable {
                                height: 236px;
                                content-width: root.recent-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.recent-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }

                        if root.playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "推荐歌单"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.playlists.length * 192px;
                                content-height: self.height;
                                for item[index] in root.playlists : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.daily-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "每日推荐"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.daily-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.daily-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }

                        if root.new-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "新歌速递"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.new-tracks.length * 192px;
                                content-height: self.height;
                                for track[index] in root.new-tracks : TrackShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: track;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }
                    }
                }

                if root.page == "library" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 20px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            Text { text: "资料库"; color: #f5f5f7; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            if root.logged-in : PillButton {
                                label: "新建歌单";
                                width: 92px;
                                clicked => { root.open-playlist-dialog("create"); }
                            }
                            if root.logged-in : PillButton {
                                label: "添加歌单";
                                width: 92px;
                                clicked => { root.open-playlist-dialog("add"); }
                            }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        if !root.logged-in : Rectangle {
                            height: 88px;
                            border-radius: 16px;
                            background: #1b1c1e;
                            border-width: 1px;
                            border-color: #ffffff10;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 14px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 52px; height: 52px; border-radius: 26px; background: #c92027;
                                    Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/user.svg"); glyph-size: 24px; tint: #fff; }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: center;
                                    Text { text: "登录网易云音乐"; color: #f5f5f7; font-size: 15px; font-weight: 650; }
                                    Text { text: "扫码后自动同步你的歌单、喜欢的歌曲和最近播放。"; color: #8e8e93; font-size: 11px; overflow: elide; }
                                }
                                Glyph { source: @image-url("../assets/icons/chevron-right.svg"); glyph-size: 16px; tint: #77777d; }
                            }
                            library-login-tap := TouchArea { clicked => { root.login-open = true; root.refresh-qr(); } }
                        }

                        if root.logged-in && root.library-playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "我的歌单"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.library-playlists : PlaylistRow {
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.logged-in && root.library-tracks.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "最近播放"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for track in root.library-tracks : MediaRow {
                                    item: track;
                                    current: track.id == root.current-id;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }

                        if !root.logged-in : Text {
                            text: "登录后，你的歌单和最近播放会显示在这里。";
                            color: #77777d;
                            font-size: 12px;
                        }
                    }
                }

                if root.page == "search" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 20px;

                        HorizontalLayout {
                            spacing: 16px;
                            cross-axis-alignment: center;
                            Text { text: "搜索"; color: #f5f5f7; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 34px; height: 34px; border-radius: 17px;
                                background: @linear-gradient(135deg, #7e838d, #3c4149);
                                Text { text: root.account-initial; color: #fff; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }

                        SearchField {
                            text <=> root.search-text;
                            placeholder: "搜索歌曲、歌手、歌单";
                            accepted => { root.search(root.search-text); }
                        }

                        if root.search-text.is-empty : Text {
                            text: "输入关键词，搜索网易云音乐。";
                            color: #77777d;
                            font-size: 13px;
                        }

                        if !root.search-text.is-empty : HorizontalLayout {
                            spacing: 8px;
                            PillButton { label: "歌曲"; width: 84px; primary: root.search-kind == "song"; clicked => { root.search-kind = "song"; } }
                            PillButton { label: "歌单"; width: 84px; primary: root.search-kind == "playlist"; clicked => { root.search-kind = "playlist"; } }
                            PillButton { label: "歌手"; width: 84px; primary: root.search-kind == "artist"; clicked => { root.search-kind = "artist"; } }
                            PillButton { label: "专辑"; width: 84px; primary: root.search-kind == "album"; clicked => { root.search-kind = "album"; } }
                        }

                        if root.search-kind == "song" && root.search-tracks.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "歌曲"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for track in root.search-tracks : MediaRow {
                                    item: track;
                                    current: track.id == root.current-id;
                                    clicked => { root.play-track(track.id); }
                                }
                            }
                        }

                        if root.search-kind == "playlist" && root.search-playlists.length > 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "歌单"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.search-playlists.length * 192px;
                                content-height: self.height;
                                for item[index] in root.search-playlists : ShelfCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-playlist(item.id); }
                                }
                            }
                        }

                        if root.search-kind == "artist" && root.search-artists.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "歌手"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.search-artists : PlaylistRow {
                                    item: item;
                                    circle: true;
                                    clicked => { root.open-artist(item.id); }
                                }
                            }
                        }

                        if root.search-kind == "album" && root.search-albums.length > 0 : VerticalLayout {
                            spacing: 10px;
                            Text { text: "专辑"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            VerticalLayout {
                                spacing: 6px;
                                for item in root.search-albums : PlaylistRow {
                                    item: item;
                                    clicked => { root.open-album(item.id); }
                                }
                            }
                        }

                        if !root.search-text.is-empty
                            && ((root.search-kind == "song" && root.search-tracks.length == 0)
                                || (root.search-kind == "playlist" && root.search-playlists.length == 0)
                                || (root.search-kind == "artist" && root.search-artists.length == 0)
                                || (root.search-kind == "album" && root.search-albums.length == 0)) : Text {
                            text: "没有找到相关结果，换个关键词试试。";
                            color: #77777d;
                            font-size: 13px;
                        }
                    }
                }

                if root.page == "recent" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 16px;
                        HorizontalLayout {
                            spacing: 12px;
                            cross-axis-alignment: center;
                            IconButton {
                                icon: @image-url("../assets/icons/arrow-left.svg");
                                icon-size: 18px;
                                width: 38px;
                                height: 38px;
                                border-radius: 19px;
                                background: #ffffff0d;
                                clicked => { root.nav("home"); }
                            }
                            Text { text: "最近播放"; color: #f5f5f7; font-size: 34px; font-weight: 700; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        if root.recent-tracks.length == 0 : Text {
                            text: "还没有最近播放";
                            color: #8e8e93;
                            font-size: 13px;
                        }
                        VerticalLayout {
                            spacing: 6px;
                            for track in root.recent-tracks : MediaRow {
                                item: track;
                                current: track.id == root.current-id;
                                clicked => { root.play-track(track.id); }
                            }
                        }
                    }
                }

                if root.page == "detail" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding-bottom: 140px;
                        spacing: 0px;

                        Rectangle {
                            height: 430px;
                            clip: true;
                            background: root.detail-cover-tint;
                            Image {
                                visible: root.cover-accent && !root.low-power;
                                width: 100%;
                                height: 100%;
                                source: root.detail-backdrop;
                                image-fit: cover;
                                image-rendering: smooth;
                                opacity: 0.95;
                            }
                            Rectangle {
                                width: 100%;
                                height: 100%;
                                background: @linear-gradient(180deg, #00000055 0%, #00000055 45%, #000000ee 100%);
                            }
                            IconButton {
                                x: 24px; y: 20px;
                                icon: @image-url("../assets/icons/arrow-left.svg");
                                icon-size: 18px;
                                width: 38px; height: 38px;
                                border-radius: 19px;
                                background: #00000033;
                                border-width: 1px;
                                border-color: #ffffff1a;
                                clicked => { root.back-detail(); }
                            }
                            if root.detail-kind == "playlist" && root.logged-in : PillButton {
                                x: parent.width - 132px;
                                y: 23px;
                                label: root.detail-subscribed ? "已收藏" : "收藏歌单";
                                width: 96px;
                                primary: root.detail-subscribed;
                                clicked => { root.toggle-subscribe(); }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                padding-top: 70px;
                                Text {
                                    text: root.detail-title;
                                    color: #ffffff;
                                    font-size: 42px;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.detail-meta;
                                    color: #ffffffa8;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.detail-description;
                                    color: #ffffff66;
                                    font-size: 11px;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                    height: 40px;
                                    overflow: elide;
                                }
                            }
                            Rectangle {
                                x: (parent.width - 96px) / 2;
                                y: 318px;
                                width: 96px;
                                height: 64px;
                                border-radius: 23px;
                                background: detail-play-tap.has-hover ? #ffffff : #f5f4f2;
                                transform-scale-x: detail-play-tap.pressed ? 96% : (detail-play-tap.has-hover ? 102% : 100%);
                                transform-scale-y: detail-play-tap.pressed ? 96% : (detail-play-tap.has-hover ? 102% : 100%);
                                animate transform-scale-x, transform-scale-y { duration: 120ms; easing: ease-out; }
                                drop-shadow-color: #00000066;
                                drop-shadow-blur: 24px;
                                drop-shadow-offset-y: 8px;
                                Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/play-fill.svg"); glyph-size: 24px; tint: #111111; }
                                detail-play-tap := TouchArea {
                                    clicked => {
                                        if root.detail-first-id != "" {
                                            root.play-detail(root.detail-first-id);
                                        }
                                    }
                                }
                            }
                        }

                        VerticalLayout {
                            padding-top: 18px; padding-left: 30px; padding-right: 30px;
                            spacing: 8px;
                            if root.detail-tracks.length > 0 : Text {
                                text: "歌曲";
                                color: #f5f5f7;
                                font-size: 20px;
                                font-weight: 700;
                            }
                            VerticalLayout {
                                spacing: 6px;
                                for track in root.detail-tracks : DetailRow {
                                    item: track;
                                    current: track.id == root.current-id;
                                    clicked => { root.play-detail(track.id); }
                                }
                            }
                        }

                        if root.detail-kind == "artist" && root.detail-albums.length > 0 : VerticalLayout {
                            padding-top: 18px; padding-left: 30px; padding-right: 30px;
                            spacing: 12px;
                            Text { text: "专辑"; color: #f5f5f7; font-size: 20px; font-weight: 700; }
                            Flickable {
                                height: 236px;
                                content-width: root.detail-albums.length * 192px;
                                content-height: self.height;
                                for item[index] in root.detail-albums : FeatureCard {
                                    x: index * 192px;
                                    y: 0;
                                    item: item;
                                    clicked => { root.open-album(item.id); }
                                }
                            }
                        }
                    }
                }

                if root.page == "settings" : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 30px;
                        padding-bottom: 140px;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 12px;
                            IconButton {
                                icon: @image-url("../assets/icons/close.svg");
                                icon-size: 17px;
                                width: 34px; height: 34px; border-radius: 17px;
                                background: #ffffff0d;
                                clicked => { root.nav("home"); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }

                        HorizontalLayout {
                            spacing: 0px;
                            Rectangle { horizontal-stretch: 1; }
                            Rectangle {
                                width: 980px;
                                background: #1b1c1e;
                                border-radius: 24px;
                            border-width: 1px;
                            border-color: #ffffff10;
                            VerticalLayout {
                                padding: 22px;
                                spacing: 16px;
                                Text { text: "账户与设置"; color: #f5f5f7; font-size: 20px; font-weight: 700; horizontal-alignment: center; }

                                Rectangle {
                                    height: 88px;
                                    border-radius: 16px;
                                    background: #242528;
                                    HorizontalLayout {
                                        padding: 14px;
                                        spacing: 14px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 56px; height: 56px; border-radius: 28px;
                                            background: @linear-gradient(135deg, #7e838d, #3c4149);
                                            Text { text: root.account-initial; color: #fff; font-size: 18px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 4px;
                                            alignment: center;
                                            Text { text: root.logged-in ? root.account-name : "网易云未登录"; color: #f5f5f7; font-size: 15px; font-weight: 600; overflow: elide; }
                                            Text { text: root.logged-in ? "UID " + root.account-id : "点击扫码登录"; color: #8e8e93; font-size: 11px; overflow: elide; }
                                        }
                                        if root.logged-in : PillButton { label: "退出登录"; clicked => { root.logout(); } }
                                        if !root.logged-in : PillButton { label: "登录"; primary: true; clicked => { root.login-open = true; root.refresh-qr(); } }
                                    }
                                }

                                Text { text: "个性化"; color: #8e8e93; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                SettingsToggleRow {
                                    title: "封面取色";
                                    description: "让播放页和详情页的环境光跟随当前封面。";
                                    checked: root.cover-accent;
                                    toggled(value) => { root.set-cover-accent(value); }
                                }
                                SettingsToggleRow {
                                    title: "显示歌词翻译";
                                    description: "在歌词下方显示可用翻译。";
                                    checked: root.show-translation;
                                    toggled(value) => { root.set-show-translation(value); }
                                }
                                SettingsToggleRow {
                                    title: "性能模式";
                                    description: "关闭封面模糊等效果，降低低配电脑的占用。";
                                    checked: root.low-power;
                                    toggled(value) => { root.set-low-power(value); }
                                }

                                Text { text: "播放音质（下一首生效）"; color: #8e8e93; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton { label: "标准"; primary: root.quality == "standard"; clicked => { root.set-quality("standard"); } }
                                    PillButton { label: "较高"; primary: root.quality == "higher"; clicked => { root.set-quality("higher"); } }
                                    PillButton { label: "极高"; primary: root.quality == "exhigh"; clicked => { root.set-quality("exhigh"); } }
                                    PillButton { label: "无损"; primary: root.quality == "lossless"; clicked => { root.set-quality("lossless"); } }
                                    PillButton { label: "Hi-Res"; primary: root.quality == "hires"; clicked => { root.set-quality("hires"); } }
                                }

                                Text { text: "日志级别"; color: #8e8e93; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    PillButton { label: "Debug"; primary: root.log-level == "debug"; clicked => { root.set-log-level("debug"); } }
                                    PillButton { label: "Info"; primary: root.log-level == "info"; clicked => { root.set-log-level("info"); } }
                                    PillButton { label: "Warn"; primary: root.log-level == "warn"; clicked => { root.set-log-level("warn"); } }
                                    PillButton { label: "Error"; primary: root.log-level == "error"; clicked => { root.set-log-level("error"); } }
                                    PillButton { label: "关闭"; primary: root.log-level == "none"; clicked => { root.set-log-level("none"); } }
                                }

                                Text { text: "数据与日志"; color: #8e8e93; font-size: 11px; font-weight: 650; letter-spacing: 1px; }
                                Rectangle {
                                    height: 64px;
                                    border-radius: 16px;
                                    background: #242528;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 12px;
                                        cross-axis-alignment: center;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 3px;
                                            alignment: center;
                                            Text { text: "数据目录"; color: #8e8e93; font-size: 10px; }
                                            Text { text: root.data-dir; color: #c7c7cc; font-size: 11px; overflow: elide; }
                                        }
                                        PillButton { label: "打开日志目录"; width: 120px; clicked => { root.open-log-folder(); } }
                                    }
                                }

                                Text { text: "Decro 0.3.0 · Slint 原生版 · 数据便携"; color: #66666c; font-size: 10px; horizontal-alignment: center; }
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }

    // ── Dock ─────────────────────────────────────────────────────────────
    Rectangle {
        visible: !root.player-open;
        x: root.sidebar-width + 26px;
        y: root.height - root.dock-height - 18px;
        width: root.width - root.sidebar-width - 52px;
        height: root.dock-height;
        z: 30;
        border-radius: 26px;
        background: #1b1c1e;
        border-width: 1px;
        border-color: #ffffff12;

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 22px;
            spacing: 14px;
            cross-axis-alignment: center;

            Rectangle {
                visible: !root.cover-flying;
                width: 62px;
                height: 62px;
                border-radius: 16px;
                background: root.current-cover;
                clip: true;
                drop-shadow-color: #0000003d;
                drop-shadow-blur: 16px;
                drop-shadow-offset-y: 5px;
                Image {
                    width: 100%; height: 100%;
                    source: root.current-cover-image;
                    image-fit: cover;
                    transform-scale-x: dock-cover-tap.has-hover ? 104% : 100%;
                    transform-scale-y: dock-cover-tap.has-hover ? 104% : 100%;
                    animate transform-scale-x, transform-scale-y { duration: 180ms; }
                }
                if root.current-cover-image.width == 0 : Text {
                    x: 0; y: 0; width: 100%; height: 100%;
                    text: "♪";
                    color: #ffffff88;
                    font-size: 24px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                Rectangle {
                    visible: dock-cover-tap.has-hover;
                    x: 0; y: 0; width: 100%; height: 100%;
                    background: #00000066;
                    Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/expand.svg"); glyph-size: 18px; tint: #fff; }
                }
                dock-cover-tap := TouchArea { clicked => { root.open-player(); } }
            }

            Rectangle {
                horizontal-stretch: 1;
                height: 62px;
                background: transparent;
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text { text: root.current-title; color: #f5f5f7; font-size: 16px; font-weight: 550; overflow: elide; }
                    Text { text: root.current-artist; color: #8e8e93; font-size: 13px; overflow: elide; }
                }
                TouchArea { clicked => { root.open-player(); } }
            }

            RoundIconButton {
                icon: root.loading ? @image-url("../assets/icons/more.svg") : (root.playing ? @image-url("../assets/icons/pause-fill.svg") : @image-url("../assets/icons/play-fill.svg"));
                icon-size: 22px;
                button-size: 40px;
                background-color: transparent;
                clicked => { root.toggle-play(); }
            }
            RoundIconButton {
                icon: @image-url("../assets/icons/next.svg");
                icon-size: 20px;
                button-size: 40px;
                background-color: transparent;
                clicked => { root.next(); }
            }
        }

        Rectangle {
            x: 10px;
            y: parent.height - 6px;
            width: parent.width - 20px;
            height: 2px;
            border-radius: 1px;
            background: #ffffff24;
            Rectangle {
                width: root.duration > 0 ? min(parent.width, parent.width * max(0, min(1, root.progress / root.duration))) : 0px;
                height: 100%;
                border-radius: 1px;
                background: #ff645d;
            }
        }
    }

    // ── Toast ────────────────────────────────────────────────────────────
    if root.status-text != "" && !root.player-open : Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - 146px;
        width: min(root.width - 80px, 560px);
        height: 34px;
        z: 29;
        border-radius: 17px;
        background: #1b1c1ee8;
        border-width: 1px;
        border-color: #ffffff1a;
        drop-shadow-color: #00000080;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 5px;
        Text {
            x: 16px; y: 0;
            width: parent.width - 32px;
            height: parent.height;
            text: root.status-text;
            color: #c7c7cc;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    // ── Flying cover between the dock and the player ─────────────────────
    Rectangle {
        visible: root.cover-flying;
        z: 45;
        x: root.player-open ? root.player-cover-fly-x : root.sidebar-width + 36px;
        y: root.player-open ? root.player-cover-fly-y : root.height - 90px;
        width: root.player-open ? root.player-cover-size : 62px;
        height: root.player-open ? root.player-cover-size : 62px;
        border-radius: root.player-open ? 24px : 16px;
        background: root.current-cover;
        clip: true;
        drop-shadow-color: #00000066;
        drop-shadow-blur: 28px;
        drop-shadow-offset-y: 10px;
        Image { width: 100%; height: 100%; source: root.current-cover-image; image-fit: cover; image-rendering: smooth; }
        if root.current-cover-image.width == 0 : Text {
            x: 0; y: 0; width: 100%; height: 100%;
            text: "♪";
            color: #ffffff88;
            font-size: root.player-open ? 60px : 24px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        animate x, y, width, height, border-radius { duration: 380ms; easing: ease-out; }
    }

    // ── Playlist dialog ──────────────────────────────────────────────────
    if root.playlist-dialog-open : Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        z: 190;
        background: #000000b8;
        TouchArea { clicked => { root.close-playlist-dialog(); } }
        Rectangle {
            width: 440px;
            height: root.playlist-dialog-mode == "create" ? 268px : 300px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 24px;
            background: #1b1c1e;
            border-width: 1px;
            border-color: #ffffff16;
            TouchArea { }
            drop-shadow-color: #000000aa;
            drop-shadow-blur: 50px;
            drop-shadow-offset-y: 18px;
            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Text {
                        horizontal-stretch: 1;
                        text: root.playlist-dialog-mode == "create" ? "新建歌单" : "添加歌单";
                        color: #f5f5f7;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    IconButton {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 14px;
                        width: 30px; height: 30px; border-radius: 15px;
                        background: #ffffff0d;
                        clicked => { root.close-playlist-dialog(); }
                    }
                }
                Text {
                    text: root.playlist-dialog-mode == "create"
                        ? "给新歌单起一个名字。"
                        : "输入歌单 ID 或网易云歌单链接，添加到资料库。";
                    color: #8e8e93;
                    font-size: 12px;
                    wrap: word-wrap;
                }
                TextField {
                    text <=> root.playlist-dialog-text;
                    placeholder: root.playlist-dialog-mode == "create" ? "歌单名称" : "歌单 ID 或链接";
                    autofocus: true;
                    accepted => { root.submit-playlist-dialog(root.playlist-dialog-text); }
                }
                Rectangle { height: 4px; }
                HorizontalLayout {
                    spacing: 10px;
                    Rectangle { horizontal-stretch: 1; }
                    PillButton {
                        label: "取消";
                        width: 84px;
                        clicked => { root.close-playlist-dialog(); }
                    }
                    PillButton {
                        label: root.playlist-dialog-mode == "create" ? "创建" : "添加";
                        width: 84px;
                        primary: true;
                        disabled: root.playlist-dialog-text.is-empty;
                        clicked => { root.submit-playlist-dialog(root.playlist-dialog-text); }
                    }
                }
            }
        }
    }

    // ── Login modal ──────────────────────────────────────────────────────
    if root.login-open && !root.logged-in : Rectangle {
        x: 0; y: 0;
        width: 100%; height: 100%;
        z: 200;
        background: #000000cc;
        TouchArea { }
        Rectangle {
            width: 420px;
            height: 650px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: 28px;
            background: #1b1c1e;
            border-width: 1px;
            border-color: #ffffff14;
            drop-shadow-color: #000000b3;
            drop-shadow-blur: 50px;
            drop-shadow-offset-y: 20px;
            VerticalLayout {
                padding: 26px;
                spacing: 13px;
                HorizontalLayout {
                    spacing: 8px;
                    cross-axis-alignment: center;
                    Text { text: "登录网易云音乐"; color: #f5f5f7; font-size: 22px; font-weight: 700; horizontal-stretch: 1; vertical-alignment: center; }
                    IconButton {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 15px;
                        width: 30px; height: 30px; border-radius: 15px;
                        background: #ffffff0d;
                        clicked => { root.close-login(); }
                    }
                }
                Text { text: "打开网易云音乐 App 扫码登录"; color: #8e8e93; font-size: 12px; }
                Rectangle {
                    height: 280px;
                    border-radius: 18px;
                    background: #f5f5f5;
                    Image { width: 100%; height: 100%; source: root.qr-image; image-fit: contain; }
                }
                Text {
                    text: root.status-text;
                    color: #b7b7bd;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    min-height: 30px;
                }
                HorizontalLayout {
                    spacing: 8px;
                    PillButton { label: "刷新二维码"; primary: true; clicked => { root.refresh-qr(); } }
                    PillButton { label: "关闭"; clicked => { root.close-login(); } }
                }
                TextField {
                    text <=> root.cookie-text;
                    placeholder: "或粘贴网页版 MUSIC_U Cookie";
                    accepted => { root.import-cookie(root.cookie-text); }
                }
                PillButton {
                    label: "导入 Cookie";
                    width: 100%;
                    clicked => { root.import-cookie(root.cookie-text); }
                }
            }
        }
    }

    // ── Full player ──────────────────────────────────────────────────────
    if root.player-visible : Rectangle {
        x: 0;
        y: root.titlebar-height;
        width: root.width;
        height: root.height - root.titlebar-height;
        z: 40;
        background: #090a0c;
        clip: true;
        opacity: root.player-open ? 1 : 0;
        animate opacity { duration: 220ms; easing: ease-out; }

        Image {
            visible: root.cover-accent && !root.low-power;
            x: -root.width * 0.08;
            y: -root.height * 0.08;
            width: root.width * 1.16;
            height: root.height * 1.16;
            source: root.current-backdrop;
            image-fit: cover;
            image-rendering: smooth;
            opacity: 0.92;
        }
        Rectangle {
            width: 100%;
            height: 100%;
            background: @linear-gradient(180deg, #08090b40 0%, #08090b7a 52%, #08090bdd 100%);
        }
        Rectangle {
            x: -160px;
            y: root.height - 620px;
            width: 780px;
            height: 780px;
            background: @radial-gradient(circle, #c9202722 0%, #c9202700 70%);
        }
        TouchArea { }

        VerticalLayout {
            padding-top: 16px; padding-bottom: 18px; padding-left: 40px; padding-right: 40px;
            spacing: 0px;

            // Player top bar
            HorizontalLayout {
                height: 44px;
                spacing: 12px;
                cross-axis-alignment: center;
                Rectangle {
                    width: 36px; height: 36px; border-radius: 18px;
                    background: player-close-tap.has-hover ? #ffffff1c : #ffffff0d;
                    border-width: 1px;
                    border-color: #ffffff1a;
                    Glyph { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; source: @image-url("../assets/icons/chevron-down.svg"); glyph-size: 16px; tint: #ffffffb3; }
                    player-close-tap := TouchArea { clicked => { root.close-player(); } }
                }
                Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #ff645d; }
                Text { text: "正在播放"; color: #ffffff94; font-size: 10px; font-weight: 650; letter-spacing: 1px; vertical-alignment: center; }
                Text { text: "网易云音乐"; color: #ffffff4d; font-size: 10px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    height: 22px;
                    width: 54px;
                    border-radius: 5px;
                    background: #7aa9f01a;
                    border-width: 1px;
                    border-color: #7aa9f033;
                    Text { text: root.current-quality; color: #9fc0f5; font-size: 9px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                }
                if root.lyrics-mode : PillButton { label: "显示封面"; clicked => { root.lyrics-mode = false; } }
            }

            // Player body
            if !root.lyrics-mode : HorizontalLayout {
                vertical-stretch: 1;
                padding-top: 10px; padding-bottom: 10px; padding-left: 28px; padding-right: 28px;
                spacing: 70px;
                cross-axis-alignment: center;

                VerticalLayout {
                    width: 40%;
                    alignment: center;
                    cross-axis-alignment: center;
                    spacing: 14px;
                    Rectangle {
                        visible: !root.cover-flying;
                        width: root.player-cover-size;
                        height: root.player-cover-size;
                        border-radius: 24px;
                        background: root.current-cover;
                        clip: true;
                        drop-shadow-color: #00000073;
                        drop-shadow-blur: 54px;
                        drop-shadow-offset-y: 24px;
                        Image {
                            width: 100%; height: 100%;
                            source: root.current-cover-image;
                            image-fit: cover;
                            transform-scale-x: cover-tap.has-hover ? 103% : 100%;
                            transform-scale-y: cover-tap.has-hover ? 103% : 100%;
                            animate transform-scale-x, transform-scale-y { duration: 380ms; }
                        }
                        if root.current-cover-image.width == 0 : Text {
                            x: 0; y: 0; width: 100%; height: 100%;
                            text: "♪";
                            color: #ffffff66;
                            font-size: 70px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            width: 100%;
                            height: 100%;
                            background: @linear-gradient(180deg, #00000000 55%, #00000055 100%);
                        }
                        Text {
                            x: 18px;
                            y: parent.height - 28px;
                            text: root.current-album + " · 网易云音乐";
                            color: #ffffffa8;
                            font-size: 9px;
                            overflow: elide;
                        }
                        Rectangle {
                            visible: cover-tap.has-hover;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 130px;
                            height: 38px;
                            border-radius: 19px;
                            background: #00000052;
                            border-width: 1px;
                            border-color: #ffffff2e;
                            Text { text: "查看歌词"; color: #ffffffd9; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        cover-tap := TouchArea { clicked => { root.lyrics-mode = true; } }
                    }
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 14px;
                        cross-axis-alignment: center;
                        Text {
                            horizontal-stretch: 1;
                            text: root.current-title;
                            color: #ffffff;
                            font-size: 42px;
                            font-weight: 700;
                            overflow: elide;
                            horizontal-alignment: left;
                        }
                        RoundIconButton {
                            icon: @image-url("../assets/icons/star.svg");
                            icon-size: 20px;
                            button-size: 44px;
                            background-color: root.current-liked ? #ffffff1f : #ffffff0d;
                            tint: root.current-liked ? #ff645d : #ffffff;
                            clicked => { root.toggle-like(); }
                        }
                    }
                    Text {
                        text: root.current-artist;
                        color: #ffffff9e;
                        font-size: 16px;
                        overflow: elide;
                    }
                    Rectangle { height: 16px; }
                    Text {
                        text: "\"" + root.current-album + "\" · " + root.current-artist;
                        color: #ffffff85;
                        font-size: 14px;
                        overflow: elide;
                    }
                    Text {
                        text: root.current-quality + " · 网易云音乐";
                        color: #ffffff57;
                        font-size: 10px;
                    }
                    HorizontalLayout {
                        spacing: 0px;
                        PillButton {
                            label: "打开歌词";
                            width: 104px;
                            clicked => { root.lyrics-mode = true; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }

            if root.lyrics-mode : VerticalLayout {
                vertical-stretch: 1;
                padding-top: 8px; padding-left: 100px; padding-right: 100px;
                spacing: 0px;
                Text { text: root.current-title; color: #fff; font-size: 40px; font-weight: 700; overflow: elide; }
                Text { text: root.current-artist; color: #ffffff9e; font-size: 16px; }
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.lyric-follow ? "滚轮或拖动查看，点击歌词跳转" : "已暂停自动跟随"; color: #ffffff5c; font-size: 10px; vertical-alignment: center; }
                    if !root.lyric-follow : PillButton {
                        label: "回到当前";
                        clicked => {
                            root.lyric-follow = true;
                            root.lyric-scroll-y = root.lyric-target-y;
                        }
                    }
                }
                Flickable {
                    height: root.lyric-view-height;
                    content-width: self.width;
                    content-height: root.lyrics.length * root.lyric-line-height;
                    content-y <=> root.lyric-scroll-y;
                    flicked => { root.lyric-follow = false; }
                    for line[index] in root.lyrics : Rectangle {
                        y: index * root.lyric-line-height;
                        width: parent.width;
                        height: root.lyric-line-height;
                        background: line-tap.has-hover ? #ffffff08 : transparent;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                horizontal-stretch: 1;
                                text: line.text;
                                color: index == root.lyric-index ? #ffffff : #ffffff78;
                                font-size: index == root.lyric-index ? 38px : 23px;
                                font-weight: index == root.lyric-index ? 700 : 400;
                                horizontal-alignment: center;
                                overflow: elide;
                                animate color { duration: 180ms; }
                                animate font-size { duration: 180ms; }
                            }
                            if line.translation != "" && root.show-translation : Text {
                                horizontal-stretch: 1;
                                text: line.translation;
                                color: index == root.lyric-index ? #ffffffa8 : #ffffff66;
                                font-size: index == root.lyric-index ? 15px : 12px;
                                horizontal-alignment: center;
                                overflow: elide;
                                animate color { duration: 180ms; }
                                animate font-size { duration: 180ms; }
                            }
                        }
                        line-tap := TouchArea {
                            clicked => {
                                root.lyric-follow = true;
                                root.lyric-scroll-y = root.lyric-y-for(index);
                                root.seek-lyric(line.time);
                            }
                        }
                    }
                }
            }

            // Transport / progress
            VerticalLayout {
                spacing: 4px;
                SeekBar {
                    value: root.progress;
                    maximum: root.duration;
                    seek(value) => { root.seek(value); }
                }
                HorizontalLayout {
                    Text { text: root.position-text; color: #ffffff7a; font-size: 12px; }
                    Rectangle { horizontal-stretch: 1; }
                    Text { text: root.duration-text; color: #ffffff7a; font-size: 12px; }
                }
                HorizontalLayout {
                    height: 68px;
                    spacing: 8px;
                    cross-axis-alignment: center;
                    HorizontalLayout {
                        width: 220px;
                        spacing: 6px;
                        alignment: start;
                        cross-axis-alignment: center;
                        RoundIconButton {
                            icon: @image-url("../assets/icons/lyrics.svg");
                            icon-size: 18px;
                            button-size: 36px;
                            background-color: root.lyrics-mode ? #ffffff1f : transparent;
                            clicked => { root.lyrics-mode = !root.lyrics-mode; }
                        }
                        RoundIconButton {
                            icon: @image-url("../assets/icons/queue.svg");
                            icon-size: 18px;
                            button-size: 36px;
                            background-color: root.queue-open ? #ffffff1f : transparent;
                            clicked => { root.toggle-queue(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        spacing: 22px;
                        cross-axis-alignment: center;
                        RoundIconButton {
                            icon: @image-url("../assets/icons/prev.svg");
                            icon-size: 22px;
                            button-size: 62px;
                            clicked => { root.prev(); }
                        }
                        Rectangle {
                            width: 96px;
                            height: 64px;
                            border-radius: 23px;
                            background: play-tap.has-hover ? #ffffff : #f5f4f2;
                            transform-scale-x: play-tap.pressed ? 96% : (play-tap.has-hover ? 102% : 100%);
                            transform-scale-y: play-tap.pressed ? 96% : (play-tap.has-hover ? 102% : 100%);
                            animate background { duration: 140ms; }
                            animate transform-scale-x, transform-scale-y { duration: 120ms; easing: ease-out; }
                            Glyph {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                source: root.loading ? @image-url("../assets/icons/more.svg") : (root.playing ? @image-url("../assets/icons/pause-fill.svg") : @image-url("../assets/icons/play-fill.svg"));
                                glyph-size: 24px;
                                tint: #111111;
                            }
                            play-tap := TouchArea { clicked => { root.toggle-play(); } }
                        }
                        RoundIconButton {
                            icon: @image-url("../assets/icons/next.svg");
                            icon-size: 22px;
                            button-size: 62px;
                            clicked => { root.next(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    HorizontalLayout {
                        width: 220px;
                        spacing: 8px;
                        alignment: end;
                        cross-axis-alignment: center;
                        Glyph { source: @image-url("../assets/icons/volume.svg"); glyph-size: 18px; tint: #ffffff80; }
                        VolumeBar {
                            value <=> root.volume;
                            changed(value) => { root.volume-changed(value); }
                            released => { root.volume-released(root.volume); }
                        }
                    }
                }
            }
        }

        // Play queue
        if root.queue-open : Rectangle {
            width: 100%;
            height: 100%;
            background: #00000033;
            queue-scrim := TouchArea { clicked => { root.queue-open = false; } }
        }
        if root.queue-open : Rectangle {
            x: root.width - 372px;
            y: 70px;
            width: 332px;
            height: root.height - root.titlebar-height - 160px;
            z: 60;
            border-radius: 22px;
            background: #17181aee;
            border-width: 1px;
            border-color: #ffffff1a;
            clip: true;
            TouchArea { }
            drop-shadow-color: #0000008c;
            drop-shadow-blur: 40px;
            drop-shadow-offset-y: 14px;
            VerticalLayout {
                padding: 16px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 2px;
                        alignment: center;
                        Text { text: "播放队列"; color: #f5f5f7; font-size: 17px; font-weight: 700; }
                        Text { text: root.queue-tracks.length + " 首"; color: #8e8e93; font-size: 10px; }
                    }
                    IconButton {
                        icon: @image-url("../assets/icons/close.svg");
                        icon-size: 14px;
                        width: 30px; height: 30px; border-radius: 15px;
                        background: #ffffff0d;
                        clicked => { root.queue-open = false; }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        for track[index] in root.queue-tracks : Rectangle {
                            height: 54px;
                            border-radius: 12px;
                            background: index == root.queue-index ? #c9202733 : (queue-row-tap.has-hover ? #ffffff0d : transparent);
                            HorizontalLayout {
                                padding: 7px;
                                spacing: 10px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    width: 38px; height: 38px; border-radius: 9px;
                                    background: track.tint;
                                    clip: true;
                                    Image { width: 100%; height: 100%; source: track.cover; image-fit: cover; }
                                    if track.cover.width == 0 : Text {
                                        x: 0; y: 0; width: 100%; height: 100%;
                                        text: "♪"; color: #ffffff77; font-size: 15px;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 2px;
                                    alignment: center;
                                    Text { text: track.title; color: index == root.queue-index ? #ff8a84 : #f5f5f7; font-size: 12px; font-weight: 600; overflow: elide; }
                                    Text { text: track.artist; color: #8e8e93; font-size: 10px; overflow: elide; }
                                }
                                Text { text: track.duration; color: #77777d; font-size: 9px; vertical-alignment: center; }
                            }
                            queue-row-tap := TouchArea { clicked => { root.play-queue(index); } }
                        }
                    }
                }
            }
        }
    }
}
